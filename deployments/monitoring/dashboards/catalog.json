      "targets": [
        {
          "refId": "A",
          "expr": "(open_agentic_catalog_job_oldest_runnable_age_seconds{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\",catalog_role=\"worker\"}) and on (job,instance,catalog_deployment,catalog_role) (open_agentic_catalog_operational_snapshot_available{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\",catalog_role=\"worker\"} == 1) and on (job,instance,catalog_deployment,catalog_role) (up{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\"} == 1)",
