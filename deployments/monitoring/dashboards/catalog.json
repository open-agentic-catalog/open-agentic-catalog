      "id": 10,
      "title": "Runnable Job age (per reporting worker)",
      "type": "timeseries",
      "description": "Database-global value per reporting worker: never sum replicas. API-only selection is not applicable. Missing data or snapshot availability 0 means unavailable, not zero.",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
