{
  "uid": "catalog-overview",
  "title": "Catalog overview",
  "tags": [
    "catalog"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "utc",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Catalog Prometheus",
          "value": "catalog-prometheus"
        }
      },
      {
        "name": "deployment",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(open_agentic_catalog_process_uptime_seconds, catalog_deployment)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "local",
          "value": "local"
        }
      },
      {
        "name": "role",
        "label": "Role",
        "type": "custom",
        "query": "api,worker",
        "includeAll": true,
        "allValue": "api|worker",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "multi": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Scrape health",
      "type": "timeseries",
      "description": "Scope: one selected Catalog deployment. Missing telemetry is not healthy zero. Scrape health is not application readiness.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\"}",
          "legendFormat": "{{catalog_role}} {{instance}} {{state}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable / no samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Runtime sample availability",
      "type": "timeseries",
      "description": "Scope: one selected Catalog deployment. Missing telemetry is not healthy zero. Scrape health is not application readiness.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(min by (catalog_deployment, catalog_role, job, instance) (open_agentic_catalog_go_metric_available{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\"})) and on (job,instance,catalog_deployment,catalog_role) (up{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\"} == 1)",
          "legendFormat": "{{catalog_role}} {{instance}} {{state}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable / no samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "Product request rate",
      "type": "timeseries",
      "description": "Scope: one selected Catalog deployment. Missing telemetry is not healthy zero. Scrape health is not application readiness.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (catalog_deployment,catalog_role) (rate(open_agentic_catalog_http_responses_total{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\",route!~\"/(metrics|livez|readyz|startupz|status|version|openapi.*)\"}[$__rate_interval]) and on (job,instance,catalog_deployment,catalog_role) (up{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\"} == 1))",
          "legendFormat": "{{catalog_role}} {{instance}} {{state}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Unavailable / no samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "Product server errors",
      "type": "timeseries",
      "description": "Scope: one selected Catalog deployment. Missing telemetry is not healthy zero. Scrape health is not application readiness.",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (catalog_deployment,catalog_role) (rate(open_agentic_catalog_http_responses_total{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\",status_class=\"5xx\",route!~\"/(metrics|livez|readyz|startupz|status|version|openapi.*)\"}[$__rate_interval]) and on (job,instance,catalog_deployment,catalog_role) (up{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\"} == 1))) or on (catalog_deployment,catalog_role) (0 * (sum by (catalog_deployment,catalog_role) (rate(open_agentic_catalog_http_responses_total{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\",route!~\"/(metrics|livez|readyz|startupz|status|version|openapi.*)\"}[$__rate_interval]) and on (job,instance,catalog_deployment,catalog_role) (up{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\"} == 1))))",
          "legendFormat": "{{catalog_role}} {{instance}} {{state}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Unavailable / no samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "Server latency p95 (bucket estimate)",
      "type": "timeseries",
      "description": "Scope: one selected Catalog deployment. Missing telemetry is not healthy zero. Scrape health is not application readiness.",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le,catalog_deployment,catalog_role) (rate(open_agentic_catalog_http_request_duration_seconds_bucket{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\",route!~\"/(metrics|livez|readyz|startupz|status|version|openapi.*)\"}[$__rate_interval]) and on (job,instance,catalog_deployment,catalog_role) (up{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\"} == 1))) and on (catalog_deployment,catalog_role) ((sum by (catalog_deployment,catalog_role) (increase(open_agentic_catalog_http_request_duration_seconds_count{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\",route!~\"/(metrics|livez|readyz|startupz|status|version|openapi.*)\"}[$__rate_interval]) and on (job,instance,catalog_deployment,catalog_role) (up{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\"} == 1))) > 0)",
          "legendFormat": "{{catalog_role}} {{instance}} {{state}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Unavailable / no samples"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "title": "Completed requests in window",
      "type": "timeseries",
      "description": "Scope: one selected Catalog deployment. Missing telemetry is not healthy zero. Scrape health is not application readiness.",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (catalog_deployment,catalog_role) (increase(open_agentic_catalog_http_responses_total{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\",route!~\"/(metrics|livez|readyz|startupz|status|version|openapi.*)\"}[$__rate_interval]) and on (job,instance,catalog_deployment,catalog_role) (up{catalog_deployment=~\"${deployment:regex}\",catalog_role=~\"${role:regex}\"} == 1))",
          "legendFormat": "{{catalog_role}} {{instance}} {{state}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Unavailable / no samples"
        },
