# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b
# Example-only fixed TLS ingress, built with the backend's pinned toolchain.
FROM docker.io/library/golang:1.27.3-alpine3.24@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS build
ENV GOTOOLCHAIN=local CGO_ENABLED=0
WORKDIR /src
COPY tls-frontend.go ./
RUN --network=none go build -trimpath -buildvcs=false -ldflags="-s -w" -o /frontend tls-frontend.go

FROM scratch
COPY --from=build --chmod=0555 /frontend /frontend
COPY --from=build /usr/local/go/LICENSE /licenses/go/LICENSE
COPY LICENSE /licenses/catalog-tutorial/LICENSE
USER 65532:65532
EXPOSE 8443 8445 9443 9445
ENTRYPOINT ["/frontend"]
