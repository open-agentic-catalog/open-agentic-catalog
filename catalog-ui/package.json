{
  "name": "catalog-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "author": "Mihai Criveti",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "generate": "openapi-typescript ../api/openapi/control-v1.yaml -o src/api/schema.d.ts",
    "client-check": "node scripts/client-check.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.build.json && vite build",
    "check": "tsc --noEmit && tsc -p tsconfig.browser.json && npm run client-check && npm run lint && npm run dead-code:check",
    "dead-code:report": "node node_modules/knip/bin/knip.js --config knip.json --no-progress --no-exit-code && node node_modules/knip/bin/knip.js --config knip.json --no-progress --production --no-exit-code",
    "dead-code:check": "node node_modules/knip/bin/knip.js --config knip.json --no-progress && node node_modules/knip/bin/knip.js --config knip.json --no-progress --production",
    "lint": "eslint . --max-warnings 0 && (cd .. && node catalog-ui/node_modules/eslint/bin/eslint.js --config catalog-ui/eslint.config.mjs test/embeddings/*.mjs --max-warnings 0) && npm run format-check",
    "format-check": "prettier --check src scripts tests eslint.config.mjs playwright.config.ts tsconfig*.json vite.config.ts vitest.config.ts package.json knip.json ../test/embeddings/*.mjs",
    "test": "npm run test:coverage && node --test scripts/*.test.mjs",
    "test:unit": "npm run test:coverage && node --test scripts/*.unit.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:coverage:100": "vitest run --coverage --coverage.thresholds.lines=100 --coverage.thresholds.statements=100 --coverage.thresholds.functions=100 --coverage.thresholds.branches=100",
    "test:browser": "node scripts/browser-test.mjs",
    "browser-install": "playwright install chromium",
    "test:property": "vitest run src/views/code-document.property.test.ts",
    "test:mutation": "node scripts/mutation.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "10.0.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-testing-library": "7.16.2",
    "fast-check": "4.10.2",
    "globals": "17.13.0",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-instrument": "6.0.3",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "jsdom": "28.1.0",
    "knip": "6.41.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "typed-rest-client": {
      "qs": "6.16.1"
    }
  }
}
