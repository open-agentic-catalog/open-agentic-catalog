{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-agentic-catalog/open-agentic-catalog/schemas/event/v1",
  "title": "Open Agentic Catalog notification CloudEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "dataschema", "data"],
  "properties": {
    "specversion": {"const": "1.0"},
    "id": {"type": "string", "format": "uuid"},
    "source": {"type": "string", "pattern": "^https://github[.]com/open-agentic-catalog/open-agentic-catalog/tenants/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
    "type": {
      "enum": [
        "com.open.agentic.catalog.catalog.listing.created.v1",
        "com.open.agentic.catalog.catalog.listing.revised.v1",
        "com.open.agentic.catalog.identity.membership.offboarded.v1",
        "com.open.agentic.catalog.identity.membership.provisioned.v1",
        "com.open.agentic.catalog.identity.membership.reactivated.v1",
        "com.open.agentic.catalog.identity.membership.suspended.v1",
        "com.open.agentic.catalog.identity.realm.reactivated.v1",
        "com.open.agentic.catalog.identity.realm.suspended.v1",
        "com.open.agentic.catalog.identity.role.assignment.granted.v1",
        "com.open.agentic.catalog.identity.role.assignment.revoked.v1",
        "com.open.agentic.catalog.listing.release.deprecated.v1",
        "com.open.agentic.catalog.listing.release.published.v1",
        "com.open.agentic.catalog.listing.release.retired.v1",
        "com.open.agentic.catalog.listing.release.revoked.v1",
        "com.open.agentic.catalog.listing.release.superseded.v1",
        "com.open.agentic.catalog.namespace.created.v1",
        "com.open.agentic.catalog.namespace.updated.v1",
        "com.open.agentic.catalog.observation.adopted.v1",
        "com.open.agentic.catalog.publication.activated.v1",
        "com.open.agentic.catalog.publication.unpublished.v1",
        "com.open.agentic.catalog.publisher.created.v1",
        "com.open.agentic.catalog.publisher.publication.domain.approved.v1",
        "com.open.agentic.catalog.publisher.publication.domain.revoked.v1",
        "com.open.agentic.catalog.publisher.updated.v1",
        "com.open.agentic.catalog.resource.created.v1",
        "com.open.agentic.catalog.resource.deleted.v1",
        "com.open.agentic.catalog.resource.version.created.v1",
        "com.open.agentic.catalog.resource.version.revised.v1",
        "com.open.agentic.catalog.review.decision.recorded.v1",
        "com.open.agentic.catalog.review.submission.created.v1",
        "com.open.agentic.catalog.source.connected.v1",
        "com.open.agentic.catalog.source.paused.v1",
        "com.open.agentic.catalog.source.removed.v1",
        "com.open.agentic.catalog.source.resumed.v1",
        "com.open.agentic.catalog.source.revision.activated.v1",
        "com.open.agentic.catalog.source.sync.completed.v1",
        "com.open.agentic.catalog.source.sync.failed.v1",
        "com.open.agentic.catalog.version.revision.validated.v1",
        "com.open.agentic.catalog.webhook.test.v1"
      ]
    },
    "subject": {"type": "string", "format": "uuid"},
    "time": {"type": "string", "format": "date-time"},
    "datacontenttype": {"const": "application/json"},
    "dataschema": {"const": "https://github.com/open-agentic-catalog/open-agentic-catalog/schemas/event/v1"},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "targetType", "targetId"],
      "properties": {
        "action": {
          "enum": [
            "catalog.listing.created",
            "catalog.listing.revised",
            "identity.membership.offboarded",
            "identity.membership.provisioned",
            "identity.membership.reactivated",
            "identity.membership.suspended",
            "identity.realm.reactivated",
            "identity.realm.suspended",
            "identity.role.assignment.granted",
            "identity.role.assignment.revoked",
            "listing.release.deprecated",
            "listing.release.published",
            "listing.release.retired",
            "listing.release.revoked",
            "listing.release.superseded",
            "namespace.created",
            "namespace.updated",
            "observation.adopted",
            "publication.activated",
            "publication.unpublished",
            "publisher.created",
            "publisher.publication.domain.approved",
            "publisher.publication.domain.revoked",
            "publisher.updated",
            "resource.created",
            "resource.deleted",
            "resource.version.created",
            "resource.version.revised",
            "review.decision.recorded",
            "review.submission.created",
            "source.connected",
            "source.paused",
            "source.removed",
            "source.resumed",
            "source.revision.activated",
            "source.sync.completed",
            "source.sync.failed",
            "version.revision.validated",
            "webhook.test"
          ]
        },
        "targetType": {
          "enum": ["catalog_listing", "federation_source", "listing_release", "namespace", "publication_snapshot", "publisher", "resource", "resource_version", "review_submission", "role_assignment", "source_snapshot", "tenant_identity_realm", "tenant_membership", "version_revision", "webhook_endpoint"]
        },
        "targetId": {"type": "string", "format": "uuid"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[a-z0-9.:-]+$",
          "anyOf": [{"format": "hostname"}, {"format": "ipv4"}, {"format": "ipv6"}]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"data": {"properties": {"action": {"enum": ["publication.activated", "publication.unpublished"]}}}}},
      "then": {"properties": {"data": {"required": ["host"]}}},
      "else": {"properties": {"data": {"not": {"required": ["host"]}}}}
    }
  ],
  "oneOf": [
    {"properties": {"type": {"const": "com.open.agentic.catalog.catalog.listing.created.v1"}, "data": {"properties": {"action": {"const": "catalog.listing.created"}, "targetType": {"const": "catalog_listing"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.catalog.listing.revised.v1"}, "data": {"properties": {"action": {"const": "catalog.listing.revised"}, "targetType": {"const": "catalog_listing"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.identity.membership.offboarded.v1"}, "data": {"properties": {"action": {"const": "identity.membership.offboarded"}, "targetType": {"const": "tenant_membership"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.identity.membership.provisioned.v1"}, "data": {"properties": {"action": {"const": "identity.membership.provisioned"}, "targetType": {"const": "tenant_membership"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.identity.membership.reactivated.v1"}, "data": {"properties": {"action": {"const": "identity.membership.reactivated"}, "targetType": {"const": "tenant_membership"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.identity.membership.suspended.v1"}, "data": {"properties": {"action": {"const": "identity.membership.suspended"}, "targetType": {"const": "tenant_membership"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.identity.realm.reactivated.v1"}, "data": {"properties": {"action": {"const": "identity.realm.reactivated"}, "targetType": {"const": "tenant_identity_realm"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.identity.realm.suspended.v1"}, "data": {"properties": {"action": {"const": "identity.realm.suspended"}, "targetType": {"const": "tenant_identity_realm"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.identity.role.assignment.granted.v1"}, "data": {"properties": {"action": {"const": "identity.role.assignment.granted"}, "targetType": {"const": "role_assignment"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.identity.role.assignment.revoked.v1"}, "data": {"properties": {"action": {"const": "identity.role.assignment.revoked"}, "targetType": {"const": "role_assignment"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.listing.release.deprecated.v1"}, "data": {"properties": {"action": {"const": "listing.release.deprecated"}, "targetType": {"const": "listing_release"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.listing.release.published.v1"}, "data": {"properties": {"action": {"const": "listing.release.published"}, "targetType": {"const": "listing_release"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.listing.release.retired.v1"}, "data": {"properties": {"action": {"const": "listing.release.retired"}, "targetType": {"const": "listing_release"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.listing.release.revoked.v1"}, "data": {"properties": {"action": {"const": "listing.release.revoked"}, "targetType": {"const": "listing_release"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.listing.release.superseded.v1"}, "data": {"properties": {"action": {"const": "listing.release.superseded"}, "targetType": {"const": "listing_release"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.namespace.created.v1"}, "data": {"properties": {"action": {"const": "namespace.created"}, "targetType": {"const": "namespace"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.namespace.updated.v1"}, "data": {"properties": {"action": {"const": "namespace.updated"}, "targetType": {"const": "namespace"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.observation.adopted.v1"}, "data": {"properties": {"action": {"const": "observation.adopted"}, "targetType": {"const": "resource"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.publication.activated.v1"}, "data": {"required": ["host"], "properties": {"action": {"const": "publication.activated"}, "targetType": {"const": "publication_snapshot"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.publication.unpublished.v1"}, "data": {"required": ["host"], "properties": {"action": {"const": "publication.unpublished"}, "targetType": {"const": "publication_snapshot"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.publisher.created.v1"}, "data": {"properties": {"action": {"const": "publisher.created"}, "targetType": {"const": "publisher"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.publisher.publication.domain.approved.v1"}, "data": {"properties": {"action": {"const": "publisher.publication.domain.approved"}, "targetType": {"const": "publisher"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.publisher.publication.domain.revoked.v1"}, "data": {"properties": {"action": {"const": "publisher.publication.domain.revoked"}, "targetType": {"const": "publisher"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.publisher.updated.v1"}, "data": {"properties": {"action": {"const": "publisher.updated"}, "targetType": {"const": "publisher"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.resource.created.v1"}, "data": {"properties": {"action": {"const": "resource.created"}, "targetType": {"const": "resource"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.resource.deleted.v1"}, "data": {"properties": {"action": {"const": "resource.deleted"}, "targetType": {"const": "resource"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.resource.version.created.v1"}, "data": {"properties": {"action": {"const": "resource.version.created"}, "targetType": {"const": "resource_version"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.resource.version.revised.v1"}, "data": {"properties": {"action": {"const": "resource.version.revised"}, "targetType": {"const": "resource_version"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.review.decision.recorded.v1"}, "data": {"properties": {"action": {"const": "review.decision.recorded"}, "targetType": {"const": "review_submission"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.review.submission.created.v1"}, "data": {"properties": {"action": {"const": "review.submission.created"}, "targetType": {"const": "review_submission"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.source.connected.v1"}, "data": {"properties": {"action": {"const": "source.connected"}, "targetType": {"const": "federation_source"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.source.paused.v1"}, "data": {"properties": {"action": {"const": "source.paused"}, "targetType": {"const": "federation_source"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.source.removed.v1"}, "data": {"properties": {"action": {"const": "source.removed"}, "targetType": {"const": "federation_source"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.source.resumed.v1"}, "data": {"properties": {"action": {"const": "source.resumed"}, "targetType": {"const": "federation_source"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.source.revision.activated.v1"}, "data": {"properties": {"action": {"const": "source.revision.activated"}, "targetType": {"const": "federation_source"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.source.sync.completed.v1"}, "data": {"properties": {"action": {"const": "source.sync.completed"}, "targetType": {"const": "source_snapshot"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.source.sync.failed.v1"}, "data": {"properties": {"action": {"const": "source.sync.failed"}, "targetType": {"const": "source_snapshot"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.version.revision.validated.v1"}, "data": {"properties": {"action": {"const": "version.revision.validated"}, "targetType": {"const": "version_revision"}}}}},
    {"properties": {"type": {"const": "com.open.agentic.catalog.webhook.test.v1"}, "data": {"properties": {"action": {"const": "webhook.test"}, "targetType": {"const": "webhook_endpoint"}}}}}
  ]
}
