# Local developer defaults. Copy this file to .env and edit only the values you need.
# Make targets load .env automatically except isolated measurement/cleanup targets.
# catalogd and catalogctl never read .env; deployments inject variables explicitly.

# Makefile profile selection.
CATALOG_CONFIG_FILE=config/local.json
CATALOG_CONFIG_ROLE=all
CATALOG_POSTGRES_CONFIG_FILE=config/postgres.json
CATALOG_CONTAINER_CONFIG_FILE=config/local.json

# Common safe local runtime overrides. Remove a line to use the selected JSON profile.
# Compose forwards the allowlist but owns its in-container listener, public URL,
# PostgreSQL driver and role-specific database DSNs.
CATALOG_HTTP_ADDRESS=127.0.0.1:8080
CATALOG_PUBLIC_BASE_URL=http://127.0.0.1:8080
CATALOG_DISCOVERY_HOSTS=[{"host":"127.0.0.1","tenantId":"00000000-0000-7000-8000-000000000001","mode":"anonymous","publisherDomain":"catalog.example.com"}]
# Optional explicit override; LOCAL_WEBHOOKS controls the Compose default below.
# CATALOG_WEBHOOKS_ENABLED=false
# Optional OTLP/HTTP tracing. Non-secret JSON only; authentication uses mounted files.
CATALOG_TRACING={"enabled":false}
# Development only: exact prepared Plugin fixtures; prepare inputs with make demo-archives-prepare.
# CATALOG_DEMO_ARCHIVES={"origin":"https://127.0.0.1:18443","trustBundleFile":"output/demo/archives/cert.pem","allowlistFile":"output/demo/archives/allowlist.json"}
# Standalone disposable Jaeger viewer; no existing telemetry service is selected.
TRACE_VIEWER_UI_PORT=16686
TRACE_VIEWER_OTLP_PORT=14318
# Optional hybrid search: configure one endpoint/model and apply the semantic schema first.
# See documentation/src/content/docs/operations/hybrid-search.md; no inline credentials.
CATALOG_SEMANTIC_SEARCH={"enabled":false}
# Optional listing artwork: exact HTTPS origins narrow existing federation routes.
# Private origins may name an existing tenant-assigned networkProfile.
# Public summaries require deployment, audience and individual consent.
CATALOG_RATINGS_SHARING_ENABLED=false
CATALOG_RATINGS_MINIMUM_SHARED_COUNT=5
CATALOG_LISTING_MEDIA={"allowedOrigins":[]}
# Public ANS verification keys are separate from TLS roots and credentials.
CATALOG_TRUST_VERIFICATION={"enabled":false}
CATALOG_PUBLISHER_DOMAIN_VERIFICATION={"mode":"disabled"}
# CATALOG_COMPOSE_TRUST_VERIFICATION_DIRECTORY=/absolute/path/to/public-verification-keys
CATALOG_MANAGED_MEDIA_ENABLED=false
CATALOG_SOFTWARE_ASSESSMENT_ENABLED=false
CATALOG_CREDENTIAL_RESOLUTION_ENABLED=false

# Every supported scalar runtime override is explicitly allowlisted. These
# examples are commented because the checked-in local profile already supplies
# them. Booleans accept only true or false; durations use Go duration syntax.
# CATALOG_ENVIRONMENT=development
# CATALOG_PROFILE=local
# Startup logging: debug|info|warn|error and text|json; restart after changes.
# CATALOG_LOG_LEVEL=info
# CATALOG_LOG_FORMAT=text
# Independent UI launcher settings (ui-dev and compose-up LOCAL_UI=on).
# CATALOG_UI_LOG_LEVEL=info
# CATALOG_UI_LOG_FORMAT=text
# Optional HTTPS documentation override; empty uses the UI image's bundled manual.
# CATALOG_UI_DOCUMENTATION_URL=https://docs.example.com/catalog/
# ui-dev only: build with make docs-build DOCS_BASE=/docs/, then select its output.
# UI_DOCUMENTATION_DIRECTORY=/absolute/path/to/documentation/dist
# CATALOG_SERVICE_NAME=open-agentic-catalog
# CATALOG_HTTP_READ_TIMEOUT=10s
# CATALOG_HTTP_REQUEST_TIMEOUT=10s
# CATALOG_HTTP_WRITE_TIMEOUT=30s
# CATALOG_HTTP_IDLE_TIMEOUT=60s
# CATALOG_HTTP_SHUTDOWN_TIMEOUT=20s
# CATALOG_HTTP_MAX_BODY_BYTES=2097152
# CATALOG_HTTP_SERVICE_ACTIVITY_ENABLED=false # Shares process traffic with tenant administrators when enabled
# New validation findings only; retained evidence and replay are unchanged.
# CATALOG_VALIDATION_MAX_FINDINGS=128
# CATALOG_VALIDATION_MAX_DIAGNOSTIC_BYTES=65536
# Optional read-only MCP HTTP on the API listener. Restart the API after changes.
# CATALOG_MCP_ENABLED=false
# CATALOG_MCP_MAX_TOOL_BYTES=262144
# CATALOG_MCP_MAX_CONCURRENCY=4
# CATALOG_MCP_ALLOWED_ORIGINS=["https://console.example.com"]
# CATALOG_HTTP_CORS_ORIGINS=http://127.0.0.1:3000,https://console.example.com
# CATALOG_DATABASE_DRIVER=memory
# CATALOG_DATABASE_MAX_CONNECTIONS=12
# Positive per-process pool durations; restart services after changing them.
# CATALOG_DATABASE_MAX_CONN_LIFETIME=30m
# CATALOG_DATABASE_MAX_CONN_IDLE_TIME=5m
# CATALOG_DATABASE_HEALTH_CHECK_PERIOD=30s
# CATALOG_AUTH_MODE=oidc
# CATALOG_AUTH_ISSUER=https://identity.example.com
# Optional OIDC-only private CA file; leave unset for public roots.
# CATALOG_AUTH_TRUST_BUNDLE_FILE=/etc/open-agentic-catalog/oidc/trust/ca.pem
# CATALOG_AUTH_AUDIENCE=open-agentic-catalog
# CATALOG_AUTH_TENANCY_MODE=dedicated
# CATALOG_AUTH_DEDICATED_TENANT_ID=00000000-0000-7000-8000-000000000001
# CATALOG_AUTH_ORGANIZATION_CLAIM=organization_id
# CATALOG_AUTH_ENFORCE_SCOPES=false
# Durable Job defaults shared by API and worker; counts include the initial attempt.
# CATALOG_JOBS_MAX_ATTEMPTS=5
# Automatic jitter window cap, 5s..1h; bounded upstream minima may exceed it.
# CATALOG_JOBS_RETRY_CEILING=1h
# CATALOG_WORKER_POLL_INTERVAL=250ms
# CATALOG_WORKER_LEASE_DURATION=30s
# CATALOG_WORKER_CONCURRENCY=4
# CATALOG_WORKER_SOURCE_MAINTENANCE_INTERVAL=15m
# Failure-restart windows: 1s <= initial <= ceiling <= 5m; independent of healthy cadence.
# CATALOG_WORKER_DEPENDENCY_RETRY_INITIAL_DELAY=1s
# CATALOG_WORKER_DEPENDENCY_RETRY_CEILING=30s
# Routine housekeeping cadence and minimum terminal-state retention.
# CATALOG_WORKER_HOUSEKEEPING_INTERVAL=5m
# CATALOG_WORKER_TERMINAL_JOB_RETENTION=168h
# CATALOG_WORKER_ACKNOWLEDGED_OUTBOX_RETENTION=24h
# Worker-only health and metrics listener. Compose and Helm keep this off the product Service.
# CATALOG_WORKER_OPERATIONS_ADDRESS=127.0.0.1:9090
# CATALOG_FEDERATION_REQUEST_TIMEOUT=2s
# CATALOG_FEDERATION_MAX_RESPONSE_BYTES=2097152
# CATALOG_FEDERATION_MAX_REDIRECTS=3
# Live Search pages per peer: 1 preserves current behavior; allowed 1-5.
# CATALOG_FEDERATION_MAX_LIVE_PAGES_PER_SOURCE=1
# CATALOG_FEDERATION_MAX_FANOUT=3
# CATALOG_FEDERATION_MAX_HOPS=2
# CATALOG_FEDERATION_POLICY_FILE=config/federation-policy.local.json
# CATALOG_CREDENTIAL_RESOLUTION_DIRECTORY=/etc/open-agentic-catalog/federation/credentials
# CATALOG_PUBLICATION_ARD_PROFILE=ard-0.91-aa3e598
# CATALOG_PUBLICATION_AI_CATALOG_PROFILE=ai-catalog-1.0-b062278
# CATALOG_WEBHOOKS_MAX_ATTEMPTS=5
# CATALOG_WEBHOOKS_RETRY_CEILING=1h
# CATALOG_WEBHOOKS_POLICY_FILE=/etc/open-agentic-catalog/webhooks/policy/policy.json
# CATALOG_COMPOSE_WEBHOOK_DIRECTORY=/absolute/path/to/webhook-policy-and-ca
# CATALOG_WEBHOOKS_TIMEOUT=10s
# CATALOG_WEBHOOKS_POLL_INTERVAL=500ms

# Local Compose command, explicit project, host ports, and network. Override
# COMPOSE only with a command that implements compatible Docker Compose v2+ semantics.
COMPOSE=docker compose
COMPOSE_PROJECT=open-agentic-catalog
# DEMO_BASE_URL=http://127.0.0.1:8080 # defaults to selected Compose API port
DEMO_STATE_FILE=output/demo/catalog-demo-v1.json
DEMO_DATA_FILE=samples/catalog.yaml
DEMO_SAMPLE_SET=curated
DEMO_EXTEND=false
# DEMO_ARCHIVE_ORIGIN=https://172.30.255.41:8443 # derives from selected private IP
# DEMO_ARCHIVE_TRUST_FILE=output/demo/archives/cert.pem # public CA, derives from archive directory
CATALOG_COMPOSE_HTTP_PORT=8080
CATALOG_COMPOSE_POSTGRES_PORT=55432
CATALOG_COMPOSE_SUBNET=172.30.255.0/24
CATALOG_COMPOSE_FEDERATION_POLICY_FILE=config/federation-policy.local.json
# CATALOG_COMPOSE_FEDERATION_CREDENTIALS_DIRECTORY=/absolute/path/outside/repository/federation-credentials
# CATALOG_COMPOSE_FEDERATION_TRUST_DIRECTORY=/absolute/path/outside/repository/federation-trust

# Optional PostgreSQL role override. API, worker, and migration commands require
# different credentials. This API example is compatible with local Compose.
# CATALOG_DATABASE_DSN=postgres://catalog_api:catalog-api@127.0.0.1:55432/catalog?sslmode=disable
# CATALOG_DATABASE_DSN_FILE=/run/secrets/catalog-database-dsn
# CATALOG_MIGRATION_DATABASE_DSN=postgres://catalog:catalog@127.0.0.1:55432/catalog?sslmode=disable
# CATALOG_DATABASE_API_ROLE=catalog_api
# CATALOG_DATABASE_WORKER_ROLE=catalog_worker

# A direct secret and its _FILE variant are mutually exclusive. Production
# requires the cursor key and requires the webhook key only when webhooks are
# enabled. Local development derives disposable keys when neither form is set.
# CATALOG_WEBHOOK_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
# CATALOG_WEBHOOK_ENCRYPTION_KEY_FILE=/run/secrets/catalog-webhook-key
# CATALOG_CURSOR_SIGNING_KEY=<different-base64-encoded-32-byte-key>
# CATALOG_CURSOR_SIGNING_KEY_FILE=/run/secrets/catalog-cursor-key

# Advanced disposable external integration inputs. The normal PostgreSQL target
# creates its own Compose dependency; set this DSN only with test-integration-dsn.
# CATALOG_TEST_DATABASE_DSN=postgres://catalog:catalog@127.0.0.1:55440/catalog_test?sslmode=disable

# Optional build, coverage, fuzz, and live-conformance settings.
# VERSION and COMMIT are resolved automatically; explicit overrides report unknown source state.
# VERSION=fixture
# COMMIT=fixture
IMAGE=open-agentic-catalog:dev
ARTIFACT_OUTPUT=output/artifacts
CHART_VERSION=0.1.0
APP_VERSION=$(VERSION)
# Retained developer Compose only; disposable measurement ignores this file.
LOCAL_MONITORING=off
# Optional local browser host; only synthetic development login is used by Compose.
LOCAL_UI=off
# Optional offline local model only; configure semanticSearch and its schema separately.
LOCAL_EMBEDDINGS=off
# Prepared local Plugin archives only; never automatic sample population.
LOCAL_DEMO_ARCHIVES=off
# Fixed opt-in local Hello World/Everything peers; install locked tools explicitly first.
LOCAL_DEMO_RUNTIMES=off
DEMO_RUNTIME_DIR=output/demo/runtimes
DEMO_A2A_PORT=19443
DEMO_MCP_PORT=19444
# DEMO_ARCHIVE_DIR=output/demo/archives
# DEMO_ARCHIVE_IP=172.30.255.41
# DEMO_ARCHIVE_PORT=18443
# Local development webhooks; no receiver is registered automatically.
LOCAL_WEBHOOKS=on
UI_IMAGE=open-agentic-catalog-ui:dev
CATALOG_UI_PORT=4180
# Independent optional Helm monitoring; never inferred from the current context.
MONITORING_CONTEXT=
MONITORING_NAMESPACE=
MONITORING_RELEASE=catalog-monitoring
MONITORING_VALUES=
MONITORING_COMPONENT=grafana
MONITORING_PORT=13000
# Retained Compose only; ports bind to loopback (0 selects an assigned port).
CATALOG_MONITORING_PROMETHEUS_PORT=19090
CATALOG_MONITORING_GRAFANA_PORT=13000
# Local block retention, not a disk quota: 1-24 hours and 128-2048 MB.
CATALOG_MONITORING_RETENTION_HOURS=6
CATALOG_MONITORING_RETENTION_MB=512
# Disposable performance targets skip this file. Pass PERF_DURATION_SECONDS,
# PERF_WARMUP_SECONDS and PERF_WORKERS on the Make command line; see the guide.
# test-scale defaults to PERF_ITEMS=1000; explicit alternatives: 10000, 100000.
# test-load runs four bounded phases; test-soak fixes one hour and two readers.
# CONTAINER_PLATFORM=linux/arm64
# Optional local-only Minikube bootstrap cache and overall scenario deadline.
# MINIKUBE_PRELOAD_ARCHIVE=/absolute/path/to/preloaded-images-k8s-v18-v1.35.9-containerd-overlay2-amd64.tar.lz4
# MINIKUBE_TIMEOUT=40m
# coverage-unit and coverage-full bypass this file. Their additional controls
# are Make arguments: UNIT_COVERAGE_MIN=90, UNIT_CRITICAL_PACKAGE_COVERAGE_MIN=90,
# and FULL_COVERAGE_MIN=95. See the testing guide for all measured scopes.
COVERAGE_MIN=90
CORE_COVERAGE_MIN=93
CRITICAL_PACKAGE_COVERAGE_MIN=90
POSTGRES_COVERAGE_MIN=95
FUZZ_TIME=10s
SEARCH_PROJECTION_REPAIR_LIMIT=500
RESTORE_VERIFY_LIMIT=100
ARD_MANIFEST_URL=http://127.0.0.1:8080/.well-known/ard.json
ARD_PUBLISHER_URL=http://127.0.0.1:8080
ARD_REGISTRY_URL=http://127.0.0.1:8080/ard/v1
