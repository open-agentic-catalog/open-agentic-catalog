---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="source-ingestion-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 430" role="img" aria-labelledby="source-ingestion-title source-ingestion-desc">
  <title id="source-ingestion-title">Synchronize a source before committing its new view</title>
  <desc id="source-ingestion-desc">The worker claims revision-bound work, fetches approved discovery metadata and prepares observations outside the write transaction. One commit installs the completed source view with its audit and outbox evidence. Failed or partial runs preserve the last complete view.</desc>
  <defs><marker id="source-ingestion-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-divider" d="M100 52 V405 M320 52 V405 M540 52 V405" />
  <text class="svg-title" x="100" y="31" text-anchor="middle">Worker</text>
  <text class="svg-title" x="320" y="31" text-anchor="middle">Approved source</text>
  <text class="svg-title" x="540" y="31" text-anchor="middle">PostgreSQL</text>
  <path class="svg-connector" d="M100 85 H540" marker-end="url(#source-ingestion-arrow)" />
  <text class="svg-small" x="340" y="75" text-anchor="start">Claim source Job</text>
  <path class="svg-connector" d="M540 125 H100" marker-end="url(#source-ingestion-arrow)" />
  <text class="svg-small" x="125" y="115" text-anchor="start">Lease / active revision</text>
  <path class="svg-connector" d="M100 175 H320" marker-end="url(#source-ingestion-arrow)" />
  <text class="svg-small" x="210" y="165" text-anchor="middle">Fetch metadata</text>
  <path class="svg-connector" d="M320 215 H100" marker-end="url(#source-ingestion-arrow)" />
  <text class="svg-small" x="210" y="240" text-anchor="middle">Entries / evidence</text>
  <rect class="svg-node" x="25" y="260" width="150" height="56" rx="12" />
  <text class="svg-title" x="100" y="295" text-anchor="middle">Parse / scope</text>
  <path class="svg-connector" d="M100 350 H540" marker-end="url(#source-ingestion-arrow)" />
  <text class="svg-small" x="340" y="340" text-anchor="start">Commit completed view</text>
  <path class="svg-connector" d="M540 390 H100" marker-end="url(#source-ingestion-arrow)" />
  <text class="svg-small" x="125" y="380" text-anchor="start">Snapshot + audit + outbox</text>
</svg>
</div>
