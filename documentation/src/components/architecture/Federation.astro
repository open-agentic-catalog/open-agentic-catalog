---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="source-lifecycle-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 450" role="img" aria-labelledby="source-lifecycle-title source-lifecycle-desc">
  <title id="source-lifecycle-title">Onboard a source and replace its configuration</title>
  <desc id="source-lifecycle-desc">An administrator inspects and connects a source. The active revision supports independent test and synchronization actions. A later change needs a bound preview and If-Match PATCH before a new revision becomes active.</desc>
  <defs><marker id="source-lifecycle-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M190 60 H235" marker-end="url(#source-lifecycle-arrow)" />
  <path class="svg-connector" d="M320 90 V190" marker-end="url(#source-lifecycle-arrow)" />
  <path class="svg-connector" d="M410 215 H430 V185 H450" marker-end="url(#source-lifecycle-arrow)" />
  <path class="svg-connector" d="M410 245 H430 V310 H450" marker-end="url(#source-lifecycle-arrow)" />
  <path class="svg-connector" d="M230 230 H190" marker-end="url(#source-lifecycle-arrow)" />
  <path class="svg-connector" d="M105 270 V345" marker-end="url(#source-lifecycle-arrow)" />
  <path class="svg-connector" d="M190 380 H320 V270" marker-end="url(#source-lifecycle-arrow)" />
  <text class="svg-small" x="255" y="365" text-anchor="middle">New revision</text>
  <rect class="svg-node" x="20" y="30" width="170" height="60" rx="12" />
  <text class="svg-title" x="105" y="67" text-anchor="middle">Inspect source</text>
  <rect class="svg-node" x="235" y="30" width="170" height="60" rx="12" />
  <text class="svg-title" x="320" y="67" text-anchor="middle">Connect source</text>
  <rect class="svg-node-core" x="230" y="190" width="180" height="80" rx="12" />
  <text class="svg-title" x="320" y="225" text-anchor="middle">Active source</text>
  <text class="svg-title" x="320" y="249" text-anchor="middle">revision</text>
  <rect class="svg-node" x="450" y="155" width="170" height="60" rx="12" />
  <text class="svg-title" x="535" y="192" text-anchor="middle">Test source</text>
  <rect class="svg-node" x="450" y="275" width="170" height="70" rx="12" />
  <text class="svg-title" x="535" y="303" text-anchor="middle">Synchronize</text>
  <text class="svg-copy" x="535" y="327" text-anchor="middle">Durable Job</text>
  <rect class="svg-node" x="20" y="190" width="170" height="80" rx="12" />
  <text class="svg-title" x="105" y="225" text-anchor="middle">Preview</text>
  <text class="svg-title" x="105" y="249" text-anchor="middle">change</text>
  <rect class="svg-node" x="20" y="345" width="170" height="70" rx="12" />
  <text class="svg-title" x="105" y="373" text-anchor="middle">PATCH</text>
  <text class="svg-copy" x="105" y="397" text-anchor="middle">If-Match + digest</text>
</svg>
</div>
