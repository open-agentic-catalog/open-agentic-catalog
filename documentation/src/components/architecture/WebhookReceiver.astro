---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="receiver-flow-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 425" role="img" aria-labelledby="receiver-flow-title receiver-flow-desc">
  <title id="receiver-flow-title">Acknowledge durable acceptance, then reconcile</title>
  <desc id="receiver-flow-desc">The receiver verifies and deduplicates a notification, commits its inbox and only then acknowledges with 2xx. Later processing reads current authorized Catalog state. The receiver's periodic refresh also reconciles gaps, independently of notification delivery.</desc>
  <defs><marker id="receiver-flow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-divider" d="M100 55 V225 M340 55 V395 M550 55 V395" />
  <text class="svg-title" x="100" y="31" text-anchor="middle">Sender</text>
  <text class="svg-title" x="340" y="31" text-anchor="middle">Receiver</text>
  <text class="svg-title" x="550" y="31" text-anchor="middle">Catalog API</text>
  <path class="svg-connector" d="M100 100 H340" marker-end="url(#receiver-flow-arrow)" />
  <text class="svg-small" x="220" y="85" text-anchor="middle">Signed event</text>
  <rect class="svg-node" x="245" y="135" width="190" height="65" rx="12" />
  <text class="svg-title" x="340" y="163" text-anchor="middle">Commit inbox</text>
  <text class="svg-copy" x="340" y="187" text-anchor="middle">Verify + deduplicate</text>
  <path class="svg-connector" d="M340 225 H100" marker-end="url(#receiver-flow-arrow)" />
  <text class="svg-small" x="220" y="211" text-anchor="middle">2xx after commit</text>
  <path class="svg-connector" d="M340 315 H550" marker-end="url(#receiver-flow-arrow)" />
  <text class="svg-small" x="445" y="299" text-anchor="middle">Read current state</text>
  <path class="svg-connector" d="M550 355 H340" marker-end="url(#receiver-flow-arrow)" />
  <text class="svg-small" x="445" y="379" text-anchor="middle">Current result</text>
  <path class="svg-connector" d="M220 285 H340" marker-end="url(#receiver-flow-arrow)" />
  <rect class="svg-node" x="20" y="250" width="200" height="70" rx="12" />
  <text class="svg-title" x="120" y="278" text-anchor="middle">Receiver refresh</text>
  <text class="svg-copy" x="120" y="302" text-anchor="middle">Periodic / after gaps</text>
</svg>
</div>
