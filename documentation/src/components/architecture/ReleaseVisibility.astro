---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="release-visibility-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 1070" role="img" aria-labelledby="release-visibility-title release-visibility-desc">
  <title id="release-visibility-title">Current Catalog reads and snapshot discovery</title>
  <desc id="release-visibility-desc">A Publisher publishes an approved release. Eligible current records then become available through authenticated Catalog reads. A Publication Administrator separately builds and inspects a candidate for a host and audience. The administrator then activates it for snapshot discovery. Candidate generation leaves any previous active snapshot unchanged. Later releases do not refresh snapshot bytes automatically; safety withdrawal retires a containing snapshot as a whole.</desc>
  <defs><marker id="release-visibility-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 95 V165" marker-end="url(#release-visibility-arrow)" />
  <path class="svg-connector" d="M320 95 V149 H628 V340 H320 V356" marker-end="url(#release-visibility-arrow)" />
  <text class="svg-small" x="340" y="332">Separate build</text>
  <path class="svg-connector" d="M320 500 V570" marker-end="url(#release-visibility-arrow)" />
  <path class="svg-connector" d="M320 668 V738" marker-end="url(#release-visibility-arrow)" />
  <DiagramCard x={60} y={20} width={520} title={"Publish the approved release"} tone="core" lines={["Publisher authority and current eligibility"]} />
  <DiagramCard x={60} y={165} width={520} title={"Current authenticated Catalog reads"} tone="authority" lines={["Eligible released records become", "readable in browse and Search", "This is separate from discovery snapshot activation"]} />
  <DiagramCard x={60} y={356} width={520} title={"Separately build and inspect a candidate"} tone="core" lines={["Publication Administrator selects the exact host", "Tenant and publication audience", "determine eligible contents", "Any previous active snapshot stays unchanged"]} />
  <DiagramCard x={60} y={570} width={520} title={"Activate the candidate"} tone="authority" lines={["Recheck retained contents and current eligibility", "Switch this host's active-snapshot pointer"]} />
  <DiagramCard x={60} y={738} width={520} title={"Snapshot discovery reads"} tone="external" lines={["Well-known manifest, ARD Search and List", "Read active immutable snapshot bytes"]} />
  <DiagramCard x={60} y={906} width={520} title={"Later releases and corrections"} tone="warning" lines={["Rebuild and activate discovery separately;", "bytes do not refresh automatically", "Safety withdrawal can retire an entire", "snapshot that contains the release"]} />

</svg>
</div>
