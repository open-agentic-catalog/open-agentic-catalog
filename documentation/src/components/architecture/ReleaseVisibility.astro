---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="release-visibility-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 420" role="img" aria-labelledby="release-visibility-title release-visibility-desc">
  <title id="release-visibility-title">Catalog reads and host discovery update separately</title>
  <desc id="release-visibility-desc">Publishing an eligible release updates authenticated Catalog reads. A separate candidate build and activation changes host discovery. Building a candidate leaves the previous snapshot active. Later releases do not refresh snapshot bytes automatically.</desc>
  <defs><marker id="release-visibility-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M190 165 H210 V85 H450" marker-end="url(#release-visibility-arrow)" />
  <path class="svg-connector" d="M105 200 V245 H235" marker-end="url(#release-visibility-arrow)" />
  <path class="svg-connector" d="M405 245 H450" marker-end="url(#release-visibility-arrow)" />
  <path class="svg-connector" d="M535 280 V350" marker-end="url(#release-visibility-arrow)" />
  <text class="svg-copy" x="325" y="64" text-anchor="middle">Current eligible release</text>
  <text class="svg-copy" x="118" y="230" text-anchor="start">Separate build</text>
  <g><rect class="svg-node-authority" x="20" y="130" width="170" height="70" rx="10" />
<text class="svg-small" x="105.0" y="171.0" text-anchor="middle">Publish release</text></g>
  <g><rect class="svg-node-core" x="450" y="50" width="170" height="70" rx="10" />
<text class="svg-title" x="535.0" y="80.0" text-anchor="middle">Catalog reads</text>
<text class="svg-copy" x="535.0" y="102.0" text-anchor="middle">Browse + Search</text></g>
  <g><rect class="svg-node" x="235" y="210" width="170" height="70" rx="10" />
<text class="svg-small" x="320.0" y="240.0" text-anchor="middle">Build candidate</text>
<text class="svg-copy" x="320.0" y="262.0" text-anchor="middle">Host + audience</text></g>
  <g><rect class="svg-node-authority" x="450" y="210" width="170" height="70" rx="10" />
<text class="svg-small" x="535.0" y="251.0" text-anchor="middle">Activate snapshot</text></g>
  <g><rect class="svg-node-core" x="450" y="350" width="170" height="50" rx="10" />
<text class="svg-small" x="535.0" y="381.0" text-anchor="middle">Host discovery</text></g>
</svg>
</div>
