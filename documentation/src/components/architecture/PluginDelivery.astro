---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="plugin-delivery-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 1116" role="img" aria-labelledby="plugin-delivery-title plugin-delivery-desc">
  <title id="plugin-delivery-title">Plugin archive delivery and retained evidence</title>
  <desc id="plugin-delivery-desc">Arrows show data flow. Catalog retrieves a complete archive from the publisher's approved HTTPS host and inspects it without execution. PostgreSQL retains bounded validation documents, file inventory, findings, archive digest and size, not the complete archive. After review and publication, Catalog exposes discovery metadata with the external URL, digest and size. Clients download the archive directly from the publisher and verify its checksum. Revalidation and publication fetch the archive again to check its reviewed identity; retained inspection cannot recreate a missing archive.</desc>
  <defs><marker id="plugin-delivery-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 164 V234" marker-end="url(#plugin-delivery-arrow)" />
  <text class="svg-small" x="332" y="191">Archive bytes</text>
  <path class="svg-connector" d="M320 378 V448" marker-end="url(#plugin-delivery-arrow)" />
  <text class="svg-small" x="332" y="405">Retain evidence</text>
  <path class="svg-connector" d="M320 546 V616" marker-end="url(#plugin-delivery-arrow)" />
  <text class="svg-small" x="332" y="573">Review + publish</text>
  <path class="svg-connector" d="M320 714 V784" marker-end="url(#plugin-delivery-arrow)" />
  <text class="svg-small" x="332" y="741">Metadata</text>
  <path class="svg-connector" d="M320 164 V218 H628 V768 H320 V784" marker-end="url(#plugin-delivery-arrow)" />
  <text class="svg-small" x="470" y="752">Archive bytes</text>
  <DiagramCard x={60} y={20} width={520} title={"Publisher's approved HTTPS host"} tone="external" lines={["Complete ZIP or gzipped tar archive:", "plugin.json and package files", "Anonymous URL; archive availability", "stays with the publisher"]} />
  <DiagramCard x={60} y={234} width={520} title={"Catalog inspection"} tone="core" lines={["Safe fetch and bounded validation;", "no disk extraction or execution", "Archive bytes are transient; review", "governs the complete package"]} />
  <DiagramCard x={60} y={448} width={520} title={"Retained PostgreSQL evidence"} tone="authority" lines={["Bounded validation documents, file inventory and findings", "Immutable archive digest and size; not an archive backup"]} />
  <DiagramCard x={60} y={616} width={520} title={"Published discovery metadata"} tone="core" lines={["After review and publication:", "external URL, digest and size"]} />
  <DiagramCard x={60} y={784} width={520} title={"Consuming client"} tone="external" lines={["Discover metadata; fetch the", "archive directly from the publisher", "Verify the checksum before use"]} />
  <DiagramCard x={60} y={975} width={520} title={"Arrows show returned data, not requests"} tone="warning" lines={["Revalidation and publication fetch", "again to check archive identity", "Retained inspection cannot recreate a missing archive"]} />

</svg>
</div>
