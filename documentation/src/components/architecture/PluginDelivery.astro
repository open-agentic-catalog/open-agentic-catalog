---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="plugin-delivery-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 520" role="img" aria-labelledby="plugin-delivery-title plugin-delivery-desc">
  <title id="plugin-delivery-title">Plugin inspection and client download</title>
  <desc id="plugin-delivery-desc">Catalog fetches the publisher archive for inspection and retains documents, inventory and digests in PostgreSQL. Archive bytes remain transient. A client obtains the published reference from Catalog, downloads the archive directly from its publisher, and verifies the reviewed checksum.</desc>
  <defs><marker id="plugin-delivery-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-divider" d="M110 80 V495 M320 80 V495 M530 80 V495" />
  <path class="svg-connector" d="M320 130 H110" marker-end="url(#plugin-delivery-arrow)" />
  <text class="svg-copy" x="215" y="118" text-anchor="middle">Inspect archive</text>
  <path class="svg-connector" d="M110 180 H320" marker-end="url(#plugin-delivery-arrow)" />
  <text class="svg-copy" x="215" y="168" text-anchor="middle">Archive bytes</text>
  <path class="svg-connector svg-connector-authority" d="M320 180 V220" marker-end="url(#plugin-delivery-arrow)" />
  <path class="svg-connector" d="M530 335 H320" marker-end="url(#plugin-delivery-arrow)" />
  <text class="svg-copy" x="425" y="323" text-anchor="middle">Discover metadata</text>
  <path class="svg-connector" d="M320 380 H530" marker-end="url(#plugin-delivery-arrow)" />
  <text class="svg-copy" x="425" y="368" text-anchor="middle">URL + digest + size</text>
  <path class="svg-connector" d="M530 430 H110" marker-end="url(#plugin-delivery-arrow)" />
  <text class="svg-copy" x="320" y="418" text-anchor="middle">Fetch archive</text>
  <path class="svg-connector" d="M110 480 H530" marker-end="url(#plugin-delivery-arrow)" />
  <text class="svg-copy" x="320" y="468" text-anchor="middle">Archive bytes; client verifies checksum</text>
  <g><rect class="svg-node-external" x="20" y="25" width="180" height="55" rx="10" />
<text class="svg-title" x="110.0" y="58.5" text-anchor="middle">Publisher host</text></g>
  <g><rect class="svg-node" x="230" y="25" width="180" height="55" rx="10" />
<text class="svg-title" x="320.0" y="58.5" text-anchor="middle">Catalog</text></g>
  <g><rect class="svg-node-external" x="440" y="25" width="180" height="55" rx="10" />
<text class="svg-title" x="530.0" y="58.5" text-anchor="middle">Client</text></g>
  <g><rect class="svg-node-authority" x="240" y="220" width="160" height="80" rx="10" />
<text class="svg-title" x="320.0" y="244.0" text-anchor="middle">PostgreSQL</text>
<text class="svg-copy" x="320.0" y="266.0" text-anchor="middle">Documents +</text>
<text class="svg-copy" x="320.0" y="288.0" text-anchor="middle">inventory + digest</text></g>
</svg>
</div>
