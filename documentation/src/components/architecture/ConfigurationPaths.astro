---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="configuration-paths-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 1253" role="img" aria-labelledby="configuration-paths-title configuration-paths-desc">
  <title id="configuration-paths-title">Backend and UI configuration paths</title>
  <desc id="configuration-paths-desc">Launchers prepare inputs before startup. The backend combines defaults, an optional JSON configuration file and supported environment variables. It then validates configuration for the selected role. The independent UI reads required strict JSON, supplies defaults only for omitted logging fields and validates its host configuration. Invalid input stops startup. Neither binary reads dotenv files or reloads these settings automatically.</desc>
  <defs><marker id="configuration-paths-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 118 V153 H180 V188" marker-end="url(#configuration-paths-arrow)" />
  <path class="svg-connector" d="M320 118 V153 H460 V188" marker-end="url(#configuration-paths-arrow)" />
  <path class="svg-connector" d="M180 263 V382" marker-end="url(#configuration-paths-arrow)" />
  <path class="svg-connector" d="M180 506 V576" marker-end="url(#configuration-paths-arrow)" />
  <path class="svg-connector" d="M180 700 V770" marker-end="url(#configuration-paths-arrow)" />
  <path class="svg-connector" d="M180 894 V929 H320 V964" marker-end="url(#configuration-paths-arrow)" />
  <path class="svg-connector" d="M460 312 V382" marker-end="url(#configuration-paths-arrow)" />
  <path class="svg-connector" d="M460 480 V576" marker-end="url(#configuration-paths-arrow)" />
  <path class="svg-connector" d="M460 674 V770" marker-end="url(#configuration-paths-arrow)" />
  <DiagramCard x={60} y={20} width={520} title={"Before either process starts"} lines={["Make, Compose or Helm prepares", "configuration and secret inputs"]} />
  <DiagramCard x={60} y={188} width={240} title={"Backend defaults"} tone="core" lines={["Safe built-in baseline"]} />
  <DiagramCard x={340} y={188} width={240} title={["Required strict UI", "JSON"]} tone="core" lines={["Independent host", "and login settings"]} />
  <DiagramCard x={60} y={382} width={240} title={["Selected backend", "JSON"]} lines={["Optional --config", "baseline"]} />
  <DiagramCard x={340} y={382} width={240} title={"UI logging defaults"} lines={["Only omitted level and", "format receive defaults"]} />
  <DiagramCard x={60} y={576} width={240} title={["Allowlisted", "environment"]} lines={["Overrides supported", "backend settings"]} />
  <DiagramCard x={340} y={576} width={240} title={"UI host validation"} lines={["No backend", "environment overrides"]} />
  <DiagramCard x={60} y={770} width={240} title={["Selected-role", "validation"]} lines={["API, worker or", "operator requirements"]} />
  <DiagramCard x={340} y={770} width={240} title={"Start UI host"} tone="authority" lines={["Invalid settings", "stop startup"]} />
  <DiagramCard x={60} y={964} width={520} title={"Start backend process"} tone="authority" lines={["Invalid settings stop startup"]} />
  <DiagramCard x={60} y={1109} width={520} title={["Startup settings require process", "replacement"]} tone="warning" lines={["Neither binary reads dotenv files or", "reloads these settings automatically."]} />

</svg>
</div>
