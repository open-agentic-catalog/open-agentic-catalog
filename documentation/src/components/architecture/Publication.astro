---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="publication-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 380" role="img" aria-labelledby="publication-title publication-desc">
  <title id="publication-title">Build, validate and activate a discovery snapshot</title>
  <desc id="publication-desc">Eligible releases form an immutable candidate. Validation failure leaves the previous active snapshot unchanged. A successful activation atomically changes the host pointer with audit, public event and replay evidence. Host discovery reads the active snapshot for its audience.</desc>
  <defs><marker id="publication-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <text class="svg-copy" x="105" y="35" text-anchor="middle">Eligible releases</text>
  <path class="svg-connector" d="M190 105 H235" marker-end="url(#publication-arrow)" />
  <path class="svg-connector" d="M405 105 H450" marker-end="url(#publication-arrow)" />
  <path class="svg-connector" d="M320 145 V250" marker-end="url(#publication-arrow)" />
  <text class="svg-copy" x="345" y="207" text-anchor="start">Invalid</text>
  <path class="svg-connector" d="M535 145 V250" marker-end="url(#publication-arrow)" />
  <text class="svg-copy" x="552" y="207" text-anchor="start">Commit</text>
  <g><rect class="svg-node" x="20" y="65" width="170" height="80" rx="10" />
<text class="svg-small" x="105.0" y="100.0" text-anchor="middle">Build candidate</text>
<text class="svg-copy" x="105.0" y="122.0" text-anchor="middle">Immutable bundle</text></g>
  <g><rect class="svg-node" x="235" y="65" width="170" height="80" rx="10" />
<text class="svg-title" x="320.0" y="100.0" text-anchor="middle">Validate</text>
<text class="svg-copy" x="320.0" y="122.0" text-anchor="middle">Current eligibility</text></g>
  <g><rect class="svg-node-authority" x="450" y="65" width="170" height="80" rx="10" />
<text class="svg-title" x="535.0" y="100.0" text-anchor="middle">Activate</text>
<text class="svg-copy" x="535.0" y="122.0" text-anchor="middle">One transaction</text></g>
  <g><rect class="svg-node" x="235" y="250" width="170" height="70" rx="10" />
<text class="svg-title" x="320.0" y="280.0" text-anchor="middle">Keep previous</text>
<text class="svg-copy" x="320.0" y="302.0" text-anchor="middle">active snapshot</text></g>
  <g><rect class="svg-node-core" x="450" y="250" width="170" height="70" rx="10" />
<text class="svg-small" x="535.0" y="280.0" text-anchor="middle">Active snapshot</text>
<text class="svg-copy" x="535.0" y="302.0" text-anchor="middle">Host + audience</text></g>
  <text class="svg-copy" x="535" y="355" text-anchor="middle">Host discovery reads</text>
</svg>
</div>
