---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="outbound-checks-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 380" role="img" aria-labelledby="outbound-checks-title outbound-checks-desc">
  <title id="outbound-checks-title">Recheck every allowed redirect before contact</title>
  <desc id="outbound-checks-desc">URL policy and complete DNS-answer checks precede a pinned connection with hostname and certificate verification. Response reads enforce limits. An allowed redirect repeats admission for its new URL. Invalid URL or DNS policy refuses contact. Webhook redirects are forbidden, and OIDC uses a separate issuer verifier.</desc>
  <defs><marker id="outbound-checks-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M190 75 H235" marker-end="url(#outbound-checks-arrow)" />
  <path class="svg-connector" d="M405 75 H450" marker-end="url(#outbound-checks-arrow)" />
  <path class="svg-connector" d="M535 110 V220" marker-end="url(#outbound-checks-arrow)" />
  <path class="svg-connector" d="M450 255 H405" marker-end="url(#outbound-checks-arrow)" />
  <text class="svg-copy" x="426" y="202" text-anchor="middle">Redirect</text>
  <path class="svg-connector" d="M320 290 V350 H10 V75 H20" marker-end="url(#outbound-checks-arrow)" />
  <text class="svg-copy" x="177" y="339" text-anchor="middle">Admit the new URL</text>
  <path class="svg-connector" d="M105 110 V220" marker-end="url(#outbound-checks-arrow)" />
  <text class="svg-copy" x="121" y="174" text-anchor="start">Invalid URL</text>
  <path class="svg-connector" d="M320 110 V185 H105" marker-end="url(#outbound-checks-arrow)" />
  <text class="svg-copy" x="286" y="172" text-anchor="middle">Forbidden DNS</text>
  <g><rect class="svg-node" x="20" y="40" width="170" height="70" rx="10" />
<text class="svg-title" x="105.0" y="70.0" text-anchor="middle">URL policy</text>
<text class="svg-copy" x="105.0" y="92.0" text-anchor="middle">Origin + route</text></g>
  <g><rect class="svg-node" x="235" y="40" width="170" height="70" rx="10" />
<text class="svg-title" x="320.0" y="70.0" text-anchor="middle">Check DNS</text>
<text class="svg-copy" x="320.0" y="92.0" text-anchor="middle">Every answer</text></g>
  <g><rect class="svg-node" x="450" y="40" width="170" height="70" rx="10" />
<text class="svg-title" x="535.0" y="70.0" text-anchor="middle">Connect + TLS</text>
<text class="svg-copy" x="535.0" y="92.0" text-anchor="middle">Checked address</text></g>
  <g><rect class="svg-node" x="450" y="220" width="170" height="70" rx="10" />
<text class="svg-title" x="535.0" y="250.0" text-anchor="middle">Read response</text>
<text class="svg-copy" x="535.0" y="272.0" text-anchor="middle">Size + time limits</text></g>
  <g><rect class="svg-node" x="235" y="220" width="170" height="70" rx="10" />
<text class="svg-small" x="320.0" y="250.0" text-anchor="middle">Admit redirect</text>
<text class="svg-copy" x="320.0" y="272.0" text-anchor="middle">If permitted</text></g>
  <g><rect class="svg-node" x="20" y="220" width="170" height="70" rx="10" />
<text class="svg-small" x="105.0" y="261.0" text-anchor="middle">Refuse contact</text></g>
</svg>
</div>
