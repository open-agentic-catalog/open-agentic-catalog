---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="native-import-recovery-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 490" role="img" aria-labelledby="native-import-recovery-title native-import-recovery-desc">
  <title id="native-import-recovery-title">Resume a draft import</title>
  <desc id="native-import-recovery-desc">Check the original inputs, identity and private receipt before resuming saved commands. Skip acknowledged steps. Reconcile an uncertain step through authoritative reads or permitted exact replay. Complete only after every draft passes readback. A mismatch, refusal or failed readback stops work while preserving the receipt and earlier drafts.</desc>
  <defs><marker id="native-import-recovery-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M200 110 H230" marker-end="url(#native-import-recovery-arrow)" />
  <path class="svg-connector" d="M410 110 H440" marker-end="url(#native-import-recovery-arrow)" />
  <path class="svg-connector" d="M320 170 V230" marker-end="url(#native-import-recovery-arrow)" />
  <text class="svg-small" x="335" y="208">Uncertain step</text>
  <path class="svg-connector" d="M230 277 H215 V110 H230" marker-end="url(#native-import-recovery-arrow)" />
  <text class="svg-small" x="112" y="272">Resolved</text>
  <path class="svg-connector" d="M110 170 V355 H320 V390" marker-end="url(#native-import-recovery-arrow)" />
  <text class="svg-small" x="20" y="205">Mismatch</text>
  <path class="svg-connector" d="M320 325 V390" marker-end="url(#native-import-recovery-arrow)" />
  <text class="svg-small" x="335" y="379">Refused / unsafe</text>
  <path class="svg-connector" d="M530 170 V355 H320" />
  <text class="svg-small" x="546" y="200">Read</text>
  <text class="svg-small" x="546" y="222">failed</text>
  <rect class="svg-node" x="20" y="50" width="180" height="120" rx="12" />
  <text class="svg-title" x="36" y="78">Check receipt</text>
  <text class="svg-title" x="36" y="104">and inputs</text>
  <text class="svg-copy" x="36" y="133">Origin and identity</text>
  <text class="svg-copy" x="36" y="155">Read saved drafts</text>
  <rect class="svg-node-core" x="230" y="50" width="180" height="120" rx="12" />
  <text class="svg-title" x="246" y="78">Resume saved</text>
  <text class="svg-title" x="246" y="104">commands</text>
  <text class="svg-copy" x="246" y="133">Keep acknowledged</text>
  <text class="svg-copy" x="246" y="155">steps and keys</text>
  <rect class="svg-node-authority" x="440" y="50" width="180" height="120" rx="12" />
  <text class="svg-title" x="456" y="78">Read back</text>
  <text class="svg-title" x="456" y="104">every draft</text>
  <text class="svg-copy" x="456" y="133">Then complete</text>
  <text class="svg-copy" x="456" y="155">the receipt</text>
  <rect class="svg-node" x="230" y="230" width="180" height="95" rx="12" />
  <text class="svg-title" x="246" y="260">Reconcile</text>
  <text class="svg-title" x="246" y="286">saved command</text>
  <text class="svg-copy" x="246" y="312">Read or exact replay</text>
  <rect class="svg-node-warning" x="20" y="390" width="600" height="70" rx="12" />
  <text class="svg-title" x="36" y="419">Stop and investigate</text>
  <text class="svg-copy" x="36" y="445">Keep prior drafts, the receipt and original uncertain keys.</text>
</svg>
</div>
