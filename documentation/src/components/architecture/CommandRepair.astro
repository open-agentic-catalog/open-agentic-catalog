---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="command-repair-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 540" role="img" aria-labelledby="command-repair-title command-repair-desc">
  <title id="command-repair-title">Repair an interrupted command</title>
  <desc id="command-repair-desc">First prove the old execution ended, then inspect one reservation. An ineligible plan stops repair. Apply only the eligible interrupted plan. A confirmed repair retains audit evidence before retrying the original command; an uncertain apply requires a fresh plan and audit inspection.</desc>
  <defs><marker id="command-repair-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M270 75 H350" marker-end="url(#command-repair-arrow)" />
  <path class="svg-connector" d="M480 110 V170" marker-end="url(#command-repair-arrow)" />
  <path class="svg-connector" d="M350 205 H270" marker-end="url(#command-repair-arrow)" />
  <text class="svg-small" x="296" y="190">No</text>
  <path class="svg-connector" d="M480 240 V300" marker-end="url(#command-repair-arrow)" />
  <text class="svg-small" x="494" y="277">Yes</text>
  <path class="svg-connector" d="M350 335 H150 V430" marker-end="url(#command-repair-arrow)" />
  <text class="svg-small" x="42" y="315">Unknown outcome</text>
  <path class="svg-connector" d="M480 370 V430" marker-end="url(#command-repair-arrow)" />
  <text class="svg-small" x="490" y="403">Confirmed</text>
  <rect class="svg-node" x="30" y="40" width="240" height="70" rx="12" />
  <text class="svg-title" x="46" y="69">Prove old execution</text>
  <text class="svg-title" x="46" y="95">ended</text>
  <rect class="svg-node" x="350" y="40" width="260" height="70" rx="12" />
  <text class="svg-title" x="366" y="83">Plan one reservation</text>
  <rect class="svg-node-warning" x="30" y="170" width="240" height="70" rx="12" />
  <text class="svg-title" x="46" y="213">Stop and investigate</text>
  <rect class="svg-step" x="350" y="170" width="260" height="70" rx="12" />
  <text class="svg-title" x="366" y="199">Interrupted and</text>
  <text class="svg-title" x="366" y="225">eligible?</text>
  <rect class="svg-node-core" x="350" y="300" width="260" height="70" rx="12" />
  <text class="svg-title" x="366" y="343">Apply reviewed plan</text>
  <rect class="svg-node-warning" x="30" y="430" width="240" height="80" rx="12" />
  <text class="svg-title" x="46" y="461">Re-plan and</text>
  <text class="svg-title" x="46" y="487">inspect audit</text>
  <rect class="svg-node-authority" x="350" y="430" width="260" height="80" rx="12" />
  <text class="svg-title" x="366" y="461">Retain audit; retry</text>
  <text class="svg-title" x="366" y="487">original command</text>
</svg>
</div>
