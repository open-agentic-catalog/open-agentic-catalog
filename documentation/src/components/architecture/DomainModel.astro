---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="domain-model-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 570" role="img" aria-labelledby="domain-model-title domain-model-desc">
  <title id="domain-model-title">Revisions and the evidence bound to a release</title>
  <desc id="domain-model-desc">A Namespace contains Resources and their Listings. Resources own version labels and immutable content revisions. Listings own immutable listing revisions. Each ReviewSubmission binds one VersionRevision, ListingRevision and ValidationRun. An approved submission can produce a ListingRelease; eligible releases become members of a PublicationSnapshot.</desc>
  <defs><marker id="domain-model-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M190 45 H235" />
  <path class="svg-connector" d="M405 45 H450" />
  <path class="svg-connector" d="M320 70 V120" />
  <text class="svg-copy" x="342" y="104" text-anchor="middle">0..n</text>
  <path class="svg-connector" d="M320 170 V220" />
  <text class="svg-copy" x="342" y="204" text-anchor="middle">1..n</text>
  <path class="svg-connector" d="M535 70 V120" />
  <text class="svg-copy" x="557" y="104" text-anchor="middle">0..n</text>
  <path class="svg-connector" d="M235 245 H190" />
  <text class="svg-copy" x="210" y="229" text-anchor="middle">1..n</text>
  <path class="svg-connector" d="M535 170 V320" />
  <text class="svg-copy" x="556" y="275" text-anchor="start">Binds</text>
  <path class="svg-connector" d="M320 270 V300 H480 V320" />
  <text class="svg-copy" x="388" y="288" text-anchor="middle">Binds content</text>
  <path class="svg-connector" d="M105 270 V400 H480 V380" />
  <text class="svg-copy" x="240" y="390" text-anchor="middle">Binds validation</text>
  <path class="svg-connector" d="M600 380 V420 H320 V450" />
  <text class="svg-copy" x="420" y="442" text-anchor="middle">Approved tuple</text>
  <path class="svg-connector" d="M405 475 H450" />
  <text class="svg-copy" x="428" y="535" text-anchor="middle">Snapshot membership</text>
  <g><rect class="svg-node" x="20" y="20" width="170" height="50" rx="10" />
<text class="svg-node-label" x="105.0" y="51.0" text-anchor="middle">Namespace</text></g>
  <g><rect class="svg-node" x="235" y="20" width="170" height="50" rx="10" />
<text class="svg-node-label" x="320.0" y="51.0" text-anchor="middle">Resource</text></g>
  <g><rect class="svg-node" x="450" y="20" width="170" height="50" rx="10" />
<text class="svg-node-label" x="535.0" y="51.0" text-anchor="middle">CatalogListing</text></g>
  <g><rect class="svg-node" x="235" y="120" width="170" height="50" rx="10" />
<text class="svg-node-label" x="320.0" y="151.0" text-anchor="middle">ResourceVersion</text></g>
  <g><rect class="svg-node-core" x="450" y="120" width="170" height="50" rx="10" />
<text class="svg-node-label" x="535.0" y="151.0" text-anchor="middle">ListingRevision</text></g>
  <g><rect class="svg-node-core" x="235" y="220" width="170" height="50" rx="10" />
<text class="svg-node-label" x="320.0" y="251.0" text-anchor="middle">VersionRevision</text></g>
  <g><rect class="svg-node-authority" x="20" y="220" width="170" height="50" rx="10" />
<text class="svg-node-label" x="105.0" y="251.0" text-anchor="middle">ValidationRun</text></g>
  <g><rect class="svg-node-authority" x="450" y="320" width="170" height="60" rx="10" />
<text class="svg-node-label" x="535.0" y="356.0" text-anchor="middle">ReviewSubmission</text></g>
  <g><rect class="svg-node" x="235" y="450" width="170" height="50" rx="10" />
<text class="svg-node-label" x="320.0" y="481.0" text-anchor="middle">ListingRelease</text></g>
  <g><rect class="svg-node-core" x="450" y="450" width="180" height="60" rx="10" />
<text class="svg-node-label" x="540.0" y="486.0" text-anchor="middle">PublicationSnapshot</text></g>
  <text class="svg-copy" x="20" y="558" text-anchor="start">Lines show relationships, not execution order.</text>
</svg>
</div>
