---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="domain-model-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 1406" role="img" aria-labelledby="domain-model-title domain-model-desc">
  <title id="domain-model-title">Governed Catalog domain model</title>
  <desc id="domain-model-desc">A Resource owns version labels and immutable VersionRevisions. Validation runs append evidence without changing content. A Namespace owns CatalogListings and immutable ListingRevisions. A ReviewSubmission binds one exact version revision, listing revision, and validation run.

  An authorized release command creates a ListingRelease from an approved submission. Eligible releases can enter a generated PublicationSnapshot. Activation exposes discovery metadata for its exact host and audience.</desc>
  <defs><marker id="arrow-domain" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M180 118 V188" marker-end="url(#arrow-domain)" />
  <path class="svg-connector" d="M460 118 V188" marker-end="url(#arrow-domain)" />
  <path class="svg-connector" d="M180 309 V379" marker-end="url(#arrow-domain)" />
  <text class="svg-small" x="192" y="336">1..n</text>
  <path class="svg-connector" d="M460 286 V379" marker-end="url(#arrow-domain)" />
  <path class="svg-connector svg-connector-authority" d="M180 477 V512 H320 V547" marker-end="url(#arrow-domain)" />
  <text class="svg-small" x="190" y="504">1..n</text>
  <path class="svg-connector svg-connector-core" d="M180 477 V531 H12 V699 H320 V715" marker-end="url(#arrow-domain)" />
  <text class="svg-small" x="38" y="691">Exact revision</text>
  <path class="svg-connector svg-connector-core" d="M460 477 V501 H628 V669 H320 V715" marker-end="url(#arrow-domain)" />
  <text class="svg-small" x="340" y="691">Exact revision</text>
  <path class="svg-connector svg-connector-authority" d="M320 645 V715" marker-end="url(#arrow-domain)" />
  <path class="svg-connector" d="M320 859 V929" marker-end="url(#arrow-domain)" />
  <text class="svg-small" x="332" y="886">Publish</text>
  <path class="svg-connector" d="M320 1050 V1120" marker-end="url(#arrow-domain)" />
  <text class="svg-small" x="332" y="1077">Generate + activate</text>
  <path class="svg-connector" d="M320 1218 V1288" marker-end="url(#arrow-domain)" />
  <DiagramCard x={60} y={20} width={240} title={"Resource"} lines={["Stable tenant, kind and", "canonical identifier"]} />
  <DiagramCard x={340} y={20} width={240} title={"Namespace"} lines={["Ownership and", "authorization"]} />
  <DiagramCard x={60} y={188} width={240} title={"ResourceVersion"} lines={["Version label", "References to candidate", "and sealed revisions"]} />
  <DiagramCard x={340} y={188} width={240} title={"CatalogListing"} lines={["Stable presentation", "identity"]} />
  <DiagramCard x={60} y={379} width={240} title={"VersionRevision"} tone="core" lines={["Immutable representations", "and digest"]} />
  <DiagramCard x={340} y={379} width={240} title={"ListingRevision"} tone="core" lines={["Immutable metadata,", "visibility and queries"]} />
  <DiagramCard x={60} y={547} width={520} title={"ValidationRun"} tone="authority" lines={["Append-only evidence: EvidenceSet, profile and policy", "Multiple runs do not change retained content"]} />
  <DiagramCard x={60} y={715} width={520} title={"ReviewSubmission"} tone="warning" lines={["Frozen exact VersionRevision,", "ListingRevision and ValidationRun", "Binds their IDs and digests", "Review is pending or has a terminal decision"]} />
  <DiagramCard x={60} y={929} width={520} title={"ListingRelease"} lines={["An authorized publish command creates", "a release from an approved submission", "The release follows its governed lifecycle"]} />
  <DiagramCard x={60} y={1120} width={520} title={"PublicationSnapshot"} tone="core" lines={["Generate and activate an immutable host/audience bundle", "Eligible releases only"]} />
  <DiagramCard x={60} y={1288} width={520} title={"Host discovery"} tone="external" lines={["Read metadata from the active", "snapshot for the exact audience"]} />

</svg>
</div>
