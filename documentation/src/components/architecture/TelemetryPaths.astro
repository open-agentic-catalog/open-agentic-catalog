---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="telemetry-paths-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 470" role="img" aria-labelledby="telemetry-paths-title telemetry-paths-desc">
  <title id="telemetry-paths-title">Metrics are pulled; traces are pushed</title>
  <desc id="telemetry-paths-desc">Each API or worker process exposes metrics for scraping and can independently export traces. Grafana queries a Prometheus-compatible metrics backend. The optional trace exporter runs inside the Catalog process and sends spans to a separate receiver.</desc>
  <defs><marker id="telemetry-paths-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <rect class="svg-boundary" x="20" y="20" width="600" height="150" rx="14" />
  <text class="svg-title" x="320" y="50" text-anchor="middle">API / worker process</text>
  <path class="svg-connector" d="M150 270 V145" marker-end="url(#telemetry-paths-arrow)" />
  <text class="svg-small" x="165" y="220" text-anchor="start">Pull /metrics</text>
  <path class="svg-connector" d="M490 145 V270" marker-end="url(#telemetry-paths-arrow)" />
  <text class="svg-small" x="505" y="220" text-anchor="start">Push spans</text>
  <path class="svg-connector" d="M150 390 V340" marker-end="url(#telemetry-paths-arrow)" />
  <text class="svg-small" x="165" y="373" text-anchor="start">Query metrics</text>
  <rect class="svg-node" x="40" y="75" width="230" height="70" rx="12" />
  <text class="svg-title" x="155" y="103" text-anchor="middle">Metrics</text>
  <text class="svg-copy" x="155" y="127" text-anchor="middle">API or operations port</text>
  <rect class="svg-node-optional" x="370" y="75" width="230" height="70" rx="12" />
  <text class="svg-title" x="485" y="103" text-anchor="middle">Trace exporter</text>
  <text class="svg-copy" x="485" y="127" text-anchor="middle">Optional</text>
  <rect class="svg-node-external" x="20" y="270" width="260" height="70" rx="12" />
  <text class="svg-title" x="150" y="298" text-anchor="middle">Collector + backend</text>
  <text class="svg-copy" x="150" y="322" text-anchor="middle">Prometheus-compatible</text>
  <rect class="svg-node-external" x="360" y="270" width="260" height="70" rx="12" />
  <text class="svg-title" x="490" y="298" text-anchor="middle">Trace receiver</text>
  <text class="svg-copy" x="490" y="322" text-anchor="middle">OTLP/HTTP</text>
  <rect class="svg-node-external" x="20" y="390" width="260" height="60" rx="12" />
  <text class="svg-title" x="150" y="427" text-anchor="middle">Grafana</text>
</svg>
</div>
