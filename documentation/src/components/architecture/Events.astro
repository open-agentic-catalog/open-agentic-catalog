---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="events-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 470" role="img" aria-labelledby="events-title events-desc">
  <title id="events-title">A domain commit precedes optional delivery</title>
  <desc id="events-desc">State, required audit and classified outbox evidence commit together. Workers lease committed outbox records. An enabled public event may be sent to a receiver, which reads current authorized API state. Disabled or non-deliverable events drain without HTTPS.</desc>
  <defs><marker id="events-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <rect class="svg-boundary" x="20" y="20" width="310" height="150" rx="14" />
  <text class="svg-title" x="175" y="52" text-anchor="middle">One domain transaction</text>
  <path class="svg-connector" d="M370 105 H310" marker-end="url(#events-arrow)" />
  <text class="svg-small" x="340" y="86" text-anchor="middle">Lease</text>
  <path class="svg-connector" d="M495 140 V265" marker-end="url(#events-arrow)" />
  <text class="svg-small" x="505" y="212" text-anchor="start">Public event</text>
  <path class="svg-connector" d="M620 105 H632 V415 H620" marker-end="url(#events-arrow)" />
  <text class="svg-small" x="505" y="374" text-anchor="middle">Disabled / internal</text>
  <path class="svg-connector" d="M390 300 H250" marker-end="url(#events-arrow)" />
  <text class="svg-small" x="320" y="283" text-anchor="middle">API read</text>
  <path class="svg-connector" d="M80 265 V140" marker-end="url(#events-arrow)" />
  <text class="svg-small" x="91" y="220" text-anchor="start">Read state</text>
  <rect class="svg-node-authority" x="40" y="80" width="75" height="60" rx="12" />
  <text class="svg-title" x="77.5" y="117" text-anchor="middle">State</text>
  <rect class="svg-node" x="130" y="80" width="75" height="60" rx="12" />
  <text class="svg-title" x="167.5" y="117" text-anchor="middle">Audit</text>
  <rect class="svg-node" x="220" y="80" width="90" height="60" rx="12" />
  <text class="svg-title" x="265" y="117" text-anchor="middle">Outbox</text>
  <rect class="svg-node-core" x="370" y="70" width="250" height="70" rx="12" />
  <text class="svg-title" x="495" y="98" text-anchor="middle">Worker</text>
  <text class="svg-copy" x="495" y="122" text-anchor="middle">Classify event</text>
  <rect class="svg-node-core" x="20" y="265" width="230" height="70" rx="12" />
  <text class="svg-title" x="135" y="293" text-anchor="middle">Catalog API</text>
  <text class="svg-copy" x="135" y="317" text-anchor="middle">Current state</text>
  <rect class="svg-node-external" x="390" y="265" width="230" height="70" rx="12" />
  <text class="svg-title" x="505" y="293" text-anchor="middle">Receiver</text>
  <text class="svg-copy" x="505" y="317" text-anchor="middle">Signed HTTPS event</text>
  <rect class="svg-node" x="390" y="390" width="230" height="55" rx="12" />
  <text class="svg-title" x="505" y="424.5" text-anchor="middle">Drain locally</text>
</svg>
</div>
