---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="identity-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 345" role="img" aria-labelledby="identity-title identity-desc">
  <title id="identity-title">A verified token still needs Catalog permission</title>
  <desc id="identity-desc">Token verification establishes identity, configured mapping resolves the tenant, and current membership and scoped Catalog permissions decide access. Any enforced OAuth scope further limits permission. Current permission reads and domain operations use transaction-local tenant and actor context for PostgreSQL RLS. Token role claims are not grants.</desc>
  <defs><marker id="identity-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M190 100 H235" marker-end="url(#identity-arrow)" />
  <path class="svg-connector" d="M405 100 H450" marker-end="url(#identity-arrow)" />
  <path class="svg-connector" d="M535 140 V180 H320 V240" marker-end="url(#identity-arrow)" />
  <text class="svg-copy" x="356" y="169" text-anchor="middle">Denied</text>
  <path class="svg-connector" d="M535 180 V240" marker-end="url(#identity-arrow)" />
  <text class="svg-copy" x="550" y="216" text-anchor="start">Allowed</text>
  <g><rect class="svg-node-core" x="20" y="60" width="170" height="80" rx="10" />
<text class="svg-title" x="105.0" y="95.0" text-anchor="middle">Verify token</text>
<text class="svg-copy" x="105.0" y="117.0" text-anchor="middle">Issuer + audience</text></g>
  <g><rect class="svg-node" x="235" y="60" width="170" height="80" rx="10" />
<text class="svg-small" x="320.0" y="95.0" text-anchor="middle">Resolve tenant</text>
<text class="svg-copy" x="320.0" y="117.0" text-anchor="middle">Configured mapping</text></g>
  <g><rect class="svg-node-authority" x="450" y="60" width="170" height="80" rx="10" />
<text class="svg-title" x="535.0" y="95.0" text-anchor="middle">Check access</text>
<text class="svg-copy" x="535.0" y="117.0" text-anchor="middle">Membership + scope</text></g>
  <g><rect class="svg-node" x="235" y="240" width="170" height="70" rx="10" />
<text class="svg-title" x="320.0" y="281.0" text-anchor="middle">Deny request</text></g>
  <g><rect class="svg-node-authority" x="450" y="240" width="170" height="70" rx="10" />
<text class="svg-small" x="535.0" y="270.0" text-anchor="middle">Run operation</text>
<text class="svg-copy" x="535.0" y="292.0" text-anchor="middle">Tenant + actor RLS</text></g>
</svg>
</div>
