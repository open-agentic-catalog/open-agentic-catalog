---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="identity-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 978" role="img" aria-labelledby="identity-title identity-desc">
  <title id="identity-title">Inbound production identity decision</title>
  <desc id="identity-desc">A signed access token is verified for algorithm, issuer, audience, subject, and time. Configured tenancy maps it to one tenant. Exact active membership and current scoped permissions determine authorization. The API then sets tenant and actor context transaction-locally for PostgreSQL row-level security.</desc>
  <defs><marker id="arrow-identity" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 118 V188" marker-end="url(#arrow-identity)" />
  <path class="svg-connector" d="M320 263 V333" marker-end="url(#arrow-identity)" />
  <path class="svg-connector" d="M320 408 V478" marker-end="url(#arrow-identity)" />
  <path class="svg-connector" d="M320 576 V646" marker-end="url(#arrow-identity)" />
  <DiagramCard x={60} y={20} width={520} title={"1. Untrusted access token"} tone="external" lines={["Signed JWT claims", "Token role claims grant no Catalog authority"]} />
  <DiagramCard x={60} y={188} width={520} title={"2. Verify token facts"} tone="core" lines={["Algorithm, issuer, audience, subject and time"]} />
  <DiagramCard x={60} y={333} width={520} title={"3. Resolve the tenant"} lines={["Dedicated tenant or exact organization mapping"]} />
  <DiagramCard x={60} y={478} width={520} title={"4. Check current Catalog state"} tone="authority" lines={["Require exact active membership", "and permission at the action scope"]} />
  <DiagramCard x={60} y={646} width={520} title={"5. Set transaction-local RLS context"} tone="authority" lines={["Tenant, subject and membership"]} />
  <DiagramCard x={60} y={791} width={520} title={"Claims are not access grants"} tone="warning" lines={["Token-supplied role, group and", "tenant UUID claims are not authority", "If enforced, OAuth scopes limit permissions", "They do not grant Catalog permissions", "Denials do not reveal inaccessible cross-tenant objects"]} />

</svg>
</div>
