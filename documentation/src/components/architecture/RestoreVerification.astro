---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="restore-flow-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 470" role="img" aria-labelledby="restore-flow-title restore-flow-desc">
  <title id="restore-flow-title">Verify a restore before approving traffic</title>
  <desc id="restore-flow-desc">Restore into isolation, check schema, roles and profiles, then verify every tenant and page. Integrity failures stop recovery. Reported derived drift may be repaired only before complete re-verification. Resume requires reviewed evidence and operator approval.</desc>
  <defs><marker id="restore-flow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M200 95 H230" marker-end="url(#restore-flow-arrow)" />
  <path class="svg-connector" d="M410 95 H440" marker-end="url(#restore-flow-arrow)" />
  <path class="svg-connector" d="M470 140 V200 H110 V380" marker-end="url(#restore-flow-arrow)" />
  <text class="svg-small" x="95" y="275" text-anchor="end">Clean</text>
  <text class="svg-small" x="95" y="297" text-anchor="end">Reviewed</text>
  <path class="svg-connector" d="M530 140 V380" marker-end="url(#restore-flow-arrow)" />
  <text class="svg-small" x="542" y="285" text-anchor="start">Integrity</text>
  <path class="svg-connector" d="M500 140 V185 H320 V250" marker-end="url(#restore-flow-arrow)" />
  <text class="svg-small" x="335" y="222" text-anchor="start">Derived drift</text>
  <path class="svg-connector" d="M410 290 H630 V25 H530 V50" marker-end="url(#restore-flow-arrow)" />
  <text class="svg-small" x="515" y="318" text-anchor="middle">Verify again</text>
  <rect class="svg-node-core" x="20" y="50" width="180" height="90" rx="12" />
  <text class="svg-title" x="110" y="90" text-anchor="middle">Isolated</text>
  <text class="svg-title" x="110" y="114" text-anchor="middle">restore</text>
  <rect class="svg-node" x="230" y="50" width="180" height="90" rx="12" />
  <text class="svg-title" x="320" y="90" text-anchor="middle">Schema / roles</text>
  <text class="svg-title" x="320" y="114" text-anchor="middle">and profiles</text>
  <rect class="svg-node" x="440" y="50" width="180" height="90" rx="12" />
  <text class="svg-title" x="530" y="90" text-anchor="middle">Verify every</text>
  <text class="svg-title" x="530" y="114" text-anchor="middle">tenant / page</text>
  <rect class="svg-node" x="230" y="250" width="180" height="80" rx="12" />
  <text class="svg-title" x="320" y="285" text-anchor="middle">Repair derived</text>
  <text class="svg-title" x="320" y="309" text-anchor="middle">search drift</text>
  <rect class="svg-node-authority" x="20" y="380" width="180" height="70" rx="12" />
  <text class="svg-title" x="110" y="410" text-anchor="middle">Approve, then</text>
  <text class="svg-title" x="110" y="434" text-anchor="middle">resume</text>
  <rect class="svg-node-warning" x="440" y="380" width="180" height="70" rx="12" />
  <text class="svg-title" x="530" y="410" text-anchor="middle">Stop and</text>
  <text class="svg-title" x="530" y="434" text-anchor="middle">investigate</text>
</svg>
</div>
