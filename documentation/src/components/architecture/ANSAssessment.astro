---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="ans-assessment-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 365" role="img" aria-labelledby="ans-assessment-title ans-assessment-desc">
  <title id="ans-assessment-title">From a selected entry to a private assessment</title>
  <desc id="ans-assessment-desc">The API binds an exact source entry to a Job. The worker verifies public evidence under operator keys and policy, then atomically commits the private result, Job completion and audit. Reading checks current authorization and audits before disclosure. A succeeded Job can contain negative verification results.</desc>
  <defs><marker id="ans-assessment-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <text class="svg-copy" x="535" y="30" text-anchor="middle">Operator keys + policy</text>
  <path class="svg-connector" d="M190 100 H235" marker-end="url(#ans-assessment-arrow)" />
  <path class="svg-connector" d="M405 100 H450" marker-end="url(#ans-assessment-arrow)" />
  <path class="svg-connector" d="M535 140 V230" marker-end="url(#ans-assessment-arrow)" />
  <path class="svg-connector" d="M450 270 H405" marker-end="url(#ans-assessment-arrow)" />
  <g><rect class="svg-node" x="20" y="60" width="170" height="80" rx="10" />
<text class="svg-title" x="105.0" y="95.0" text-anchor="middle">Select entry</text>
<text class="svg-copy" x="105.0" y="117.0" text-anchor="middle">Source revision</text></g>
  <g><rect class="svg-node-core" x="235" y="60" width="170" height="80" rx="10" />
<text class="svg-title" x="320.0" y="95.0" text-anchor="middle">Admit Job</text>
<text class="svg-copy" x="320.0" y="117.0" text-anchor="middle">Entry + policy</text></g>
  <g><rect class="svg-node" x="450" y="60" width="170" height="80" rx="10" />
<text class="svg-small" x="535.0" y="95.0" text-anchor="middle">Verify evidence</text>
<text class="svg-copy" x="535.0" y="117.0" text-anchor="middle">Worker owns claim</text></g>
  <g><rect class="svg-node-authority" x="450" y="230" width="170" height="80" rx="10" />
<text class="svg-title" x="535.0" y="265.0" text-anchor="middle">Commit result</text>
<text class="svg-copy" x="535.0" y="287.0" text-anchor="middle">Job + audit</text></g>
  <g><rect class="svg-node" x="235" y="230" width="170" height="80" rx="10" />
<text class="svg-title" x="320.0" y="265.0" text-anchor="middle">Private read</text>
<text class="svg-copy" x="320.0" y="287.0" text-anchor="middle">Authorize + audit</text></g>
  <text class="svg-copy" x="320" y="347" text-anchor="middle">Checks: signature / inclusion / target / current status</text>
</svg>
</div>
