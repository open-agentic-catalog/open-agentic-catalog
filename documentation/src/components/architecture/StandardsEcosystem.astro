---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="standards-ecosystem-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 1047" role="img" aria-labelledby="standards-ecosystem-title standards-ecosystem-desc">
  <title id="standards-ecosystem-title">Discovery, resource formats and consuming applications</title>
  <desc id="standards-ecosystem-desc">The Catalog reads and publishes ARD discovery and separate AI Catalog documents. It validates A2A Agent Cards, MCP metadata, Agent Skills and Agent Plugin archives. Plugins can package Skills and MCP configuration. Client applications choose which resources to connect to, install or execute. The standards are independent. Discovery does not grant permission to execute a resource.</desc>
  <defs><marker id="standards-ecosystem-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 118 V153 H180 V188" marker-end="url(#standards-ecosystem-arrow)" />
  <path class="svg-connector" d="M320 118 V153 H460 V188" marker-end="url(#standards-ecosystem-arrow)" />
  <path class="svg-connector" d="M320 118 V172 H628 V722 H320 V738" marker-end="url(#standards-ecosystem-arrow)" />
  <text class="svg-small" x="340" y="714">Discover</text>
  <DiagramCard x={60} y={20} width={520} title={"Catalog: governed metadata"} tone="core" lines={["Standards describe discovery and", "resource formats; clients own execution."]} />
  <DiagramCard x={60} y={188} width={240} title={"ARD"} tone="core" lines={["Resource discovery", "Search and navigation"]} />
  <DiagramCard x={340} y={188} width={240} title={"AI Catalog"} tone="core" lines={["Catalog entries", "Artifact references"]} />
  <DiagramCard x={60} y={356} width={240} title={"A2A metadata"} lines={["Agent Cards", "Capabilities", "and interfaces"]} />
  <DiagramCard x={340} y={356} width={240} title={"MCP metadata"} lines={["Registry server.json", "Experimental Server Cards"]} />
  <DiagramCard x={60} y={547} width={240} title={"Agent Skills"} lines={["SKILL.md and", "support files"]} />
  <DiagramCard x={340} y={547} width={240} title={"Agent Plugins"} lines={["plugin.json", "Optional Skills and", "MCP configuration"]} />
  <DiagramCard x={60} y={738} width={520} title={"Consuming client applications"} tone="external" lines={["Choose a discovered resource", "Communicate with A2A; connect using MCP", "Load Skills or Plugins under the client's own permissions"]} />
  <DiagramCard x={60} y={929} width={520} title={"Discovery does not authorize execution"} tone="warning" lines={["The discovery, resource and client", "protocols remain independent."]} />

</svg>
</div>
