---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="webhook-outcomes-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 510" role="img" aria-labelledby="webhook-outcomes-title webhook-outcomes-desc">
  <title id="webhook-outcomes-title">Receiver acceptance and local outcome commit</title>
  <desc id="webhook-outcomes-desc">A send is classified as success, waiting or dead letter. The dispatcher commits its outcome and audit under the current claim. Claim loss or an unconfirmed commit can allow recovery to resend even when the receiver already accepted the request.</desc>
  <defs><marker id="webhook-outcomes-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 80 V110 H110 V145" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M320 80 V145" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M320 110 H530 V145" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M110 215 V250 H320 V295" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M320 215 V295" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M530 215 V250 H320" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M270 365 V395 H160 V425" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M370 365 V395 H480 V425" marker-end="url(#webhook-outcomes-arrow)" />
  <text class="svg-small" x="160" y="385" text-anchor="middle">Committed</text>
  <text class="svg-small" x="485" y="385" text-anchor="middle">Lost claim / write failure</text>
  <rect class="svg-node-core" x="200" y="20" width="240" height="60" rx="12" />
  <text class="svg-title" x="320" y="57" text-anchor="middle">Send HTTPS</text>
  <rect class="svg-node" x="20" y="145" width="180" height="70" rx="12" />
  <text class="svg-title" x="110" y="173" text-anchor="middle">2xx</text>
  <text class="svg-copy" x="110" y="197" text-anchor="middle">succeeded</text>
  <rect class="svg-node" x="230" y="145" width="180" height="70" rx="12" />
  <text class="svg-title" x="320" y="173" text-anchor="middle">Retryable</text>
  <text class="svg-copy" x="320" y="197" text-anchor="middle">waiting</text>
  <rect class="svg-node" x="440" y="145" width="180" height="70" rx="12" />
  <text class="svg-title" x="530" y="173" text-anchor="middle">Terminal / spent</text>
  <text class="svg-copy" x="530" y="197" text-anchor="middle">dead_letter</text>
  <rect class="svg-node-authority" x="200" y="295" width="240" height="70" rx="12" />
  <text class="svg-title" x="320" y="323" text-anchor="middle">Commit outcome</text>
  <text class="svg-copy" x="320" y="347" text-anchor="middle">Outcome + audit</text>
  <rect class="svg-node-authority" x="20" y="425" width="280" height="65" rx="12" />
  <text class="svg-title" x="160" y="453" text-anchor="middle">Outcome saved</text>
  <text class="svg-copy" x="160" y="477" text-anchor="middle">Wait or stop sends</text>
  <rect class="svg-node-warning" x="340" y="425" width="280" height="65" rx="12" />
  <text class="svg-title" x="480" y="453" text-anchor="middle">Outcome unconfirmed</text>
  <text class="svg-copy" x="480" y="477" text-anchor="middle">Recovery can resend</text>
</svg>
</div>
