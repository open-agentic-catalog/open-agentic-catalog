---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="webhook-outcomes-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 1125" role="img" aria-labelledby="webhook-outcomes-title webhook-outcomes-desc">
  <title id="webhook-outcomes-title">A recipient attempt and its local delivery outcome</title>
  <desc id="webhook-outcomes-desc">A worker sends outside the transaction, then classifies one recipient&#x27;s outcome. A 2xx response becomes succeeded. A retryable failure becomes waiting with bounded backoff if attempts remain. A terminal response or exhausted budget becomes dead_letter.

  These outcomes and audit evidence persist only while the exact claim remains owned and unexpired. The worker can send again if the receiver accepts the notification but the local outcome does not commit. Initial pending preparation need not be persisted. When webhooks are disabled, a worker can acknowledge the parent outbox event without successful delivery. This does not prove receipt.</desc>
  <defs><marker id="webhook-outcomes-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 141 V176 H180 V211" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M320 141 V176 H460 V211" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M320 141 V195 H628 V412 H320 V428" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M180 286 V382 H12 V557 H320 V573" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M460 358 V420 H618 V527 H320 V573" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M320 503 V573" marker-end="url(#webhook-outcomes-arrow)" />
  <path class="svg-connector" d="M320 694 V729 H180 V764" marker-end="url(#webhook-outcomes-arrow)" />
  <text class="svg-small" x="192" y="721">Commit</text>
  <path class="svg-connector" d="M320 694 V729 H460 V764" marker-end="url(#webhook-outcomes-arrow)" />
  <text class="svg-small" x="389" y="721">Lost claim / write failure</text>
  <DiagramCard x={60} y={20} width={520} title={"Prepare and send to one recipient"} tone="core" lines={["Recheck endpoint and renew the exact claim before HTTPS", "Send outside the database transaction", "Initial pending preparation may exist only in memory"]} />
  <DiagramCard x={60} y={211} width={240} title={"2xx response"} tone="authority" lines={["Classify as succeeded"]} />
  <DiagramCard x={340} y={211} width={240} title={["Retryable, budget", "remains"]} tone="warning" lines={["Classify as waiting", "Bounded jitter /", "receiver delay"]} />
  <DiagramCard x={60} y={428} width={520} title={"Terminal response or exhausted budget"} tone="warning" lines={["Classify as dead_letter"]} />
  <DiagramCard x={60} y={573} width={520} title={"Persist outcome and audit atomically"} tone="core" lines={["The exact tenant/event claim must", "still be owned and unexpired", "HTTPS acceptance is separate from this commit"]} />
  <DiagramCard x={60} y={764} width={240} title={"Outcome committed"} tone="authority" lines={["Waiting: defer", "until eligible", "Terminal: stop sends", "for this recipient"]} />
  <DiagramCard x={340} y={764} width={240} title={["Outcome did not", "commit"]} tone="warning" lines={["Recipient may", "have accepted", "If the outcome does not", "commit, recovery can", "resend over HTTPS"]} />
  <DiagramCard x={60} y={981} width={520} title={["Draining with webhooks disabled", "does not prove delivery"]} tone="warning" lines={["The worker can acknowledge the outbox event", "without successful delivery or later backfill"]} />

</svg>
</div>
