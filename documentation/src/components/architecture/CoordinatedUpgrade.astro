---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="coordinated-upgrade-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 380" role="img" aria-labelledby="coordinated-upgrade-title coordinated-upgrade-desc">
  <title id="coordinated-upgrade-title">Stop old runtimes before migration</title>
  <desc id="coordinated-upgrade-desc">Preflight selects the exact target. All old API Pods stop before worker Pods. The owner applies migrations and exact grants before target replicas start. Failure after drain keeps runtimes stopped for forward recovery.</desc>
  <defs><marker id="coordinated-upgrade-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M90 80 V155" marker-end="url(#coordinated-upgrade-arrow)" />
  <path class="svg-connector" d="M160 195 H175" marker-end="url(#coordinated-upgrade-arrow)" />
  <path class="svg-connector" d="M315 195 H330" marker-end="url(#coordinated-upgrade-arrow)" />
  <path class="svg-connector" d="M470 195 H485" marker-end="url(#coordinated-upgrade-arrow)" />
  <path class="svg-connector" d="M400 235 V300" marker-end="url(#coordinated-upgrade-arrow)" />
  <path class="svg-connector" d="M555 235 V270 H510 V300" marker-end="url(#coordinated-upgrade-arrow)" />
  <text class="svg-small" x="535" y="288" text-anchor="start">Failure</text>
  <rect class="svg-node-core" x="20" y="20" width="600" height="60" rx="12" />
  <text class="svg-title" x="320" y="57" text-anchor="middle">Preflight the selected target</text>
  <rect class="svg-node" x="20" y="155" width="140" height="80" rx="12" />
  <text class="svg-title" x="90" y="202" text-anchor="middle">Stop API</text>
  <rect class="svg-node" x="175" y="155" width="140" height="80" rx="12" />
  <text class="svg-title" x="245" y="190" text-anchor="middle">Stop</text>
  <text class="svg-title" x="245" y="214" text-anchor="middle">workers</text>
  <rect class="svg-node" x="330" y="155" width="140" height="80" rx="12" />
  <text class="svg-title" x="400" y="183" text-anchor="middle">Apply SQL</text>
  <text class="svg-copy" x="400" y="207" text-anchor="middle">Owner only</text>
  <rect class="svg-node" x="485" y="155" width="140" height="80" rx="12" />
  <text class="svg-title" x="555" y="183" text-anchor="middle">Start target</text>
  <text class="svg-copy" x="555" y="207" text-anchor="middle">Verify</text>
  <rect class="svg-node-warning" x="330" y="300" width="295" height="60" rx="12" />
  <text class="svg-title" x="477.5" y="337" text-anchor="middle">Keep runtimes stopped</text>
</svg>
</div>
