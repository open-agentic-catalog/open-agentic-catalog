---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="coordinated-upgrade-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 1169" role="img" aria-labelledby="coordinated-upgrade-title coordinated-upgrade-desc">
  <title id="coordinated-upgrade-title">A coordinated Helm image upgrade</title>
  <desc id="coordinated-upgrade-desc">The operator selects one target chart, values and image, then preflights the owned deployment. The coordinator drains every old API Pod, then every old worker Pod, before the schema owner applies forward migrations and exact runtime grants. Target replicas start from the selected values and must pass readiness and authorized readback.

  If deployment fails after drain, keep or return the runtimes to the stopped state. Correct the cause. Retry the target deployment. Do not substitute raw Helm hooks, automatic SQL rollback or a restart of the old image.</desc>
  <defs><marker id="coordinated-upgrade-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 141 V211" marker-end="url(#coordinated-upgrade-arrow)" />
  <path class="svg-connector" d="M320 309 V379" marker-end="url(#coordinated-upgrade-arrow)" />
  <path class="svg-connector" d="M320 477 V547" marker-end="url(#coordinated-upgrade-arrow)" />
  <path class="svg-connector" d="M320 645 V715" marker-end="url(#coordinated-upgrade-arrow)" />
  <path class="svg-connector" d="M320 645 V699 H12 V867 H320 V883" marker-end="url(#coordinated-upgrade-arrow)" />
  <text class="svg-small" x="38" y="859">Failure</text>
  <path class="svg-connector" d="M320 813 V837 H628 V875 H320 V883" marker-end="url(#coordinated-upgrade-arrow)" />
  <text class="svg-small" x="340" y="859">Failure</text>
  <DiagramCard x={60} y={20} width={520} title={"1. Select and preflight the target"} tone="core" lines={["Operator selects the exact chart,", "values, image and owned deployment", "Pause other deployment controllers"]} />
  <DiagramCard x={60} y={211} width={520} title={"2. Drain every old API Pod"} lines={["Remove API work before worker drain", "Wait for every selected API Pod to disappear"]} />
  <DiagramCard x={60} y={379} width={520} title={"3. Drain every old worker Pod"} lines={["No old runtime may overlap migration", "First install skips absent workloads"]} />
  <DiagramCard x={60} y={547} width={520} title={"4. Apply owner-only migration"} tone="warning" lines={["Hold the migration advisory lock", "Apply forward SQL and reconcile exact runtime grants"]} />
  <DiagramCard x={60} y={715} width={520} title={"5. Start target replicas and verify"} tone="authority" lines={["Use replica counts from the selected target values", "Check readiness, version and authorized readback"]} />
  <DiagramCard x={60} y={883} width={520} title={"Failure after drain"} tone="warning" lines={["Keep or return runtimes to stopped state", "Inspect retained evidence, fix the cause and retry forward", "Do not automatically roll back SQL or restart an old image"]} />
  <DiagramCard x={60} y={1074} width={520} title={"Compose follows equivalent stages"} lines={["Raw Helm hooks do not coordinate old-runtime drain"]} />

</svg>
</div>
