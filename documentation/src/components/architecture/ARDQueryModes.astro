---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="ard-query-modes-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 928" role="img" aria-labelledby="ard-query-modes-title ard-query-modes-desc">
  <title id="ard-query-modes-title">When an ARD Search contacts an approved peer</title>
  <desc id="ard-query-modes-desc">All three modes start with the current host&#x27;s active local publication snapshot. The none mode returns local results only. Referrals adds eligible approved Registry descriptors without upstream Search. Auto, including an omitted mode, permits bounded live Search for nonblank text and eligible approved sources. Signed live continuation repeats the same verified window until exhausted; ordinary local continuation makes no peer calls. First-page live failures preserve local results with partial diagnostics. Temporary replay failure permits retry of the same token; changed evidence requires restart. Neither a referral URL nor caller input grants contact authority.</desc>
  <defs><marker id="ard-query-modes-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 95 V130 H180 V165" marker-end="url(#ard-query-modes-arrow)" />
  <path class="svg-connector" d="M320 95 V130 H460 V165" marker-end="url(#ard-query-modes-arrow)" />
  <path class="svg-connector" d="M320 95 V149 H628 V363 H320 V379" marker-end="url(#ard-query-modes-arrow)" />
  <path class="svg-connector" d="M320 477 V547" marker-end="url(#ard-query-modes-arrow)" />
  <path class="svg-connector" d="M180 309 V333 H12 V699 H320 V715" marker-end="url(#ard-query-modes-arrow)" />
  <path class="svg-connector" d="M460 286 V371 H618 V669 H320 V715" marker-end="url(#ard-query-modes-arrow)" />
  <path class="svg-connector" d="M320 645 V715" marker-end="url(#ard-query-modes-arrow)" />
  <DiagramCard x={60} y={20} width={520} title={"Admit host and read its active snapshot"} tone="core" lines={["Apply the exact host audience and request filters"]} />
  <DiagramCard x={60} y={165} width={240} title={"none"} lines={["Local snapshot", "results only", "No upstream Search", "No referral descriptors"]} />
  <DiagramCard x={340} y={165} width={240} title={"referrals"} lines={["Eligible approved", "Registry descriptors", "No upstream Search"]} />
  <DiagramCard x={60} y={379} width={520} title={"auto, including an omitted mode"} tone="optional" lines={["Fresh query or signed live replay", "Nonblank text and approved eligible sources"]} />
  <DiagramCard x={60} y={547} width={520} title={"Bounded live pass"} lines={["No eligible source means no contact", "Replay stops when the verified live results run out"]} />
  <DiagramCard x={60} y={715} width={520} title={["Return local results and permitted", "additions"]} tone="authority" lines={["First-page live failures preserve", "local results with partial diagnostics", "Temporary replay failures allow retry of the same token", "Changed evidence requires restart;", "caller URLs grant no authority"]} />

</svg>
</div>
