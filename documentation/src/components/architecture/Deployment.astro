---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="deployment-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 1450" role="img" aria-labelledby="deployment-title deployment-desc">
  <title id="deployment-title">Helm release workloads and external infrastructure</title>
  <desc id="deployment-desc">The application release contains optional UI and MCP Ingress resources, an API Service and API replicas, worker replicas with private operations, the owner-only migration hook, and optional session-mode PgBouncer. The UI has its own image. API, worker and migration share the backend image. General Control and discovery ingress routing, ingress controllers, identity issuance and PostgreSQL infrastructure are external. Operators choose direct or pooled runtime DSNs; enabling the pooler does not rewrite Secrets. Both pooled hops verify TLS. The migration owner always connects directly. One Recreate pooler is not pooler high availability; application replica counts do not establish node or database high availability.</desc>
  <defs><marker id="deployment-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <rect class="svg-boundary" x="36" y="210" width="568" height="920" rx="18" />
  <text class="svg-kicker" x="60" y="240">APPLICATION RELEASE / NAMESPACE</text>
  <path class="svg-connector" d="M60 80 H16 V310 H60" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="32" y="175">UI</text>
  <path class="svg-connector" d="M520 118 V190 H618 V310 H580" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="450" y="175">MCP</text>
  <path class="svg-connector" d="M580 80 H634 V510 H580" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="546" y="429">API</text>
  <path class="svg-connector" d="M180 361 V460" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="198" y="423">HTTP</text>
  <path class="svg-connector" d="M460 384 V460" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="478" y="423">HTTP</text>
  <path class="svg-connector" d="M300 510 H340" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="304" y="498">API</text>
  <path class="svg-connector" d="M460 558 V680" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="478" y="630">HTTP</text>
  <path class="svg-connector svg-connector-authority" d="M180 778 V920" marker-end="url(#deployment-arrow)" />
  <path class="svg-connector svg-connector-authority" d="M460 778 V840 H180 V920" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="208" y="890">Pooled DSNs; verified TLS</text>
  <path class="svg-connector svg-connector-authority" d="M60 740 H24 V1180 H100 V1250" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="40" y="1160">Default direct</text>
  <path class="svg-connector svg-connector-authority" d="M580 740 H612 V1310 H580" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="480" y="1160">Default direct</text>
  <path class="svg-connector svg-connector-authority" d="M180 1067 V1250" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="200" y="1195">Verified TLS</text>
  <path class="svg-connector svg-connector-authority" d="M460 1067 V1250" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="340" y="1195">Owner direct</text>
  <DiagramCard x={60} y={20} width={520} title={"Clients and operator routing"} lines={["General Control/discovery routing is operator-supplied", "Ingress controllers and identity issuance are external"]} />
  <DiagramCard x={60} y={260} width={240} title={["UI ingress", "(optional)"]} lines={["UI routes and /docs"]} tone={"optional"} />
  <DiagramCard x={340} y={260} width={240} title={["MCP ingress", "(optional)"]} lines={["Only MCP and its", "OAuth metadata routes"]} tone={"optional"} />
  <DiagramCard x={60} y={460} width={240} title={["UI Service and", "UI Deployment"]} lines={["Optional; separate image", "Go host; no DB access"]} tone={"optional"} />
  <DiagramCard x={340} y={460} width={240} title={"API Service"} lines={["Control, discovery", "and enabled HTTP MCP"]} />
  <DiagramCard x={60} y={680} width={240} title={"Worker Deployment"} lines={["Worker Pod replicas", "Private operations only"]} tone={"core"} />
  <DiagramCard x={340} y={680} width={240} title={"API Deployment"} lines={["API Pod replicas", "catalogd api"]} tone={"core"} />
  <DiagramCard x={60} y={920} width={240} title={["PgBouncer", "(optional)"]} lines={["Private Service and Pod", "Session mode", "One Recreate replica"]} tone={"optional"} />
  <DiagramCard x={340} y={920} width={240} title={["Migration", "hook Job"]} lines={["Schema-owner credential", "Pre-install / pre-upgrade", "Direct database access"]} tone={"warning"} />
  <DiagramCard x={60} y={1250} width={520} title={"PostgreSQL writer and storage"} lines={["PostgreSQL 18 + pgcrypto; optional pgvector", "Infrastructure owns HA, storage and backups"]} kicker={"OPERATOR SUPPLIED"} tone={"authority"} />
  <text class="svg-small" x="20" y="1420">Routing is explicit. No worker product Service. Replicas do not imply HA.</text>
</svg>
</div>
