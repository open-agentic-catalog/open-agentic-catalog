---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---
<div class="catalog-architecture" role="region" aria-labelledby="deployment-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 610" role="img" aria-labelledby="deployment-title deployment-desc">
  <title id="deployment-title">Helm workloads and operator-supplied infrastructure</title>
  <desc id="deployment-desc">The application release contains API and worker workloads, an owner migration Job, optional UI resources and optional PgBouncer. Operators provide routing and PostgreSQL. This view shows default direct database paths; pooled routing is a separate choice. The worker has no product Service.</desc>
  <defs><marker id="deployment-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <rect class="svg-boundary" x="10" y="130" width="620" height="315" rx="16" />
  <text class="svg-title" x="380" y="162">Application release</text>
  <path class="svg-connector" d="M110 95 V195" marker-end="url(#deployment-arrow)" />
  <path class="svg-connector" d="M330 95 V195" marker-end="url(#deployment-arrow)" />
  <path class="svg-connector" d="M200 244 H240" marker-end="url(#deployment-arrow)" />
  <path class="svg-connector" d="M330 293 V510" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="342" y="474">API direct</text>
  <path class="svg-connector" d="M530 293 V315 H405 V490 H400 V510" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="442" y="474">Worker direct</text>
  <path class="svg-connector" d="M110 425 V480 H250 V510" marker-end="url(#deployment-arrow)" />
  <text class="svg-small" x="42" y="463">Owner direct</text>
  <DiagramCard x={20} y={20} width={600} title="Clients and operator routing" lines={["General routing and ingress controller are external"]} />
  <DiagramCard x={20} y={195} width={180} title="UI" tone="optional" lines={["Separate image", "Service / Ingress"]} />
  <DiagramCard x={240} y={195} width={180} title="API" tone="core" lines={["Service + replicas", "MCP ingress (opt.)"]} />
  <DiagramCard x={440} y={195} width={180} title="Worker" tone="core" lines={["Backend image", "Replicas"]} />
  <DiagramCard x={20} y={350} width={180} title="Migration Job" lines={["Owner direct"]} />
  <DiagramCard x={440} y={350} width={180} title="PgBouncer" tone="optional" lines={["Optional pooler"]} />
  <DiagramCard x={215} y={510} width={300} title="PostgreSQL 18" tone="authority" lines={["Operator-supplied writer/storage"]} />
</svg>
</div>
