---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="command-path-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 390" role="img" aria-labelledby="command-path-title command-path-desc">
  <title id="command-path-title">Preparation and one atomic command transaction</title>
  <desc id="command-path-desc">Admission checks the caller and reserves the idempotency key. Evidence preparation happens outside the domain write transaction. One PostgreSQL transaction commits domain state, required audit, classified outbox records and the retained response. The caller receives the committed result or a currently authorized replay.</desc>
  <defs><marker id="command-path-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M190 100 H235" marker-end="url(#command-path-arrow)" />
  <path class="svg-connector" d="M320 140 V190 H212 V250" marker-end="url(#command-path-arrow)" />
  <path class="svg-connector" d="M405 300 H450" marker-end="url(#command-path-arrow)" />
  <path class="svg-connector" d="M105 60 V30 H535 V250" marker-end="url(#command-path-arrow)" />
  <text class="svg-copy" x="420" y="22" text-anchor="middle">Authorized replay</text>
  <g><rect class="svg-node-core" x="20" y="60" width="170" height="80" rx="10" />
<text class="svg-title" x="105.0" y="95.0" text-anchor="middle">Admit request</text>
<text class="svg-copy" x="105.0" y="117.0" text-anchor="middle">Reserve key</text></g>
  <g><rect class="svg-node" x="235" y="60" width="170" height="80" rx="10" />
<text class="svg-small" x="320.0" y="95.0" text-anchor="middle">Prepare evidence</text>
<text class="svg-copy" x="320.0" y="117.0" text-anchor="middle">Validate / fetch</text></g>
  <g><rect class="svg-node-authority" x="20" y="250" width="385" height="100" rx="10" />
<text class="svg-title" x="212.5" y="284.0" text-anchor="middle">One PostgreSQL transaction</text>
<text class="svg-copy" x="212.5" y="306.0" text-anchor="middle">State + audit + classified outbox</text>
<text class="svg-copy" x="212.5" y="328.0" text-anchor="middle">Retained command response</text></g>
  <g><rect class="svg-node" x="450" y="250" width="170" height="100" rx="10" />
<text class="svg-title" x="535.0" y="295.0" text-anchor="middle">Return result</text>
<text class="svg-copy" x="535.0" y="317.0" text-anchor="middle">Authorize replay</text></g>
  <text class="svg-copy" x="320" y="375" text-anchor="middle">External preparation finishes before the write transaction.</text>
</svg>
</div>
