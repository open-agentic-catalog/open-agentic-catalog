---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="search-continuation-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 535" role="img" aria-labelledby="search-continuation-title search-continuation-desc">
  <title id="search-continuation-title">Search continuations keep their ranking</title>
  <desc id="search-continuation-desc">A lexical cursor stays lexical. A fresh request uses hybrid ranking when usable or classified keyword fallback. An existing hybrid cursor validates its binding and keeps its ranking; outages or changes require retry or restart.</desc>
  <defs><marker id="search-continuation-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 76 V100 H110 V125" marker-end="url(#search-continuation-arrow)" />
  <path class="svg-connector" d="M320 76 V125" marker-end="url(#search-continuation-arrow)" />
  <path class="svg-connector" d="M320 100 H530 V125" marker-end="url(#search-continuation-arrow)" />
  <path class="svg-connector" d="M110 205 V315" marker-end="url(#search-continuation-arrow)" />
  <path class="svg-connector" d="M320 205 V315" marker-end="url(#search-continuation-arrow)" />
  <path class="svg-connector" d="M270 205 V245 H180 V315" marker-end="url(#search-continuation-arrow)" />
  <path class="svg-connector" d="M530 205 V315" marker-end="url(#search-continuation-arrow)" />
  <path class="svg-connector" d="M585 205 V240 H625 V400 H530 V440" marker-end="url(#search-continuation-arrow)" />
  <text class="svg-small" x="124" y="270" text-anchor="start">Continue</text>
  <text class="svg-small" x="334" y="270" text-anchor="start">Usable</text>
  <text class="svg-small" x="224" y="236" text-anchor="middle">Fallback</text>
  <text class="svg-small" x="544" y="270" text-anchor="start">Valid</text>
  <text class="svg-small" x="515" y="413" text-anchor="end">Unavailable</text>
  <text class="svg-small" x="515" y="434" text-anchor="end">or changed</text>
  <rect class="svg-node-core" x="200" y="20" width="240" height="56" rx="12" />
  <text class="svg-title" x="320" y="55" text-anchor="middle">Search request</text>
  <rect class="svg-node" x="20" y="125" width="180" height="80" rx="12" />
  <text class="svg-title" x="110" y="160" text-anchor="middle">Lexical</text>
  <text class="svg-title" x="110" y="184" text-anchor="middle">cursor</text>
  <rect class="svg-node" x="230" y="125" width="180" height="80" rx="12" />
  <text class="svg-title" x="320" y="160" text-anchor="middle">Fresh</text>
  <text class="svg-title" x="320" y="184" text-anchor="middle">request</text>
  <rect class="svg-node" x="440" y="125" width="180" height="80" rx="12" />
  <text class="svg-title" x="530" y="160" text-anchor="middle">Hybrid</text>
  <text class="svg-title" x="530" y="184" text-anchor="middle">cursor</text>
  <rect class="svg-node-authority" x="20" y="315" width="180" height="70" rx="12" />
  <text class="svg-title" x="110" y="357" text-anchor="middle">Lexical results</text>
  <rect class="svg-node-authority" x="230" y="315" width="180" height="70" rx="12" />
  <text class="svg-title" x="320" y="357" text-anchor="middle">Hybrid results</text>
  <rect class="svg-node-authority" x="440" y="315" width="180" height="70" rx="12" />
  <text class="svg-title" x="530" y="345" text-anchor="middle">Same hybrid</text>
  <text class="svg-title" x="530" y="369" text-anchor="middle">ranking</text>
  <rect class="svg-node-warning" x="440" y="440" width="180" height="75" rx="12" />
  <text class="svg-title" x="530" y="472.5" text-anchor="middle">Retry or</text>
  <text class="svg-title" x="530" y="496.5" text-anchor="middle">restart</text>
</svg>
</div>
