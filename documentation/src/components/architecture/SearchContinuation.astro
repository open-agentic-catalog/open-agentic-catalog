---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="search-continuation-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 1362" role="img" aria-labelledby="search-continuation-title search-continuation-desc">
  <title id="search-continuation-title">Control Search fallback and cursor safety</title>
  <desc id="search-continuation-desc">Authenticated Control Search applies current permissions and explicit filters before retrieval. An existing lexical cursor stays lexical. A fresh query can use keyword fallback for classified indexing, provider or work-limit conditions.

  A valid hybrid cursor keeps its ranking. A dependency failure requires retry or restart. A changed binding or generation requires restart. Empty hybrid results are valid; unclassified database errors and caller cancellation are not keyword fallback.</desc>
  <defs><marker id="search-continuation-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 118 V188" marker-end="url(#search-continuation-arrow)" />
  <path class="svg-connector" d="M320 118 V172 H12 V340 H180 V356" marker-end="url(#search-continuation-arrow)" />
  <path class="svg-connector" d="M320 118 V142 H628 V310 H460 V356" marker-end="url(#search-continuation-arrow)" />
  <path class="svg-connector" d="M320 286 V348 H22 V580 H180 V596" marker-end="url(#search-continuation-arrow)" />
  <text class="svg-small" x="38" y="572">Same tier</text>
  <path class="svg-connector" d="M180 503 V596" marker-end="url(#search-continuation-arrow)" />
  <text class="svg-small" x="192" y="553">Classified fallback</text>
  <path class="svg-connector" d="M180 503 V561 H460 V596" marker-end="url(#search-continuation-arrow)" />
  <text class="svg-small" x="384" y="553">Usable</text>
  <path class="svg-connector" d="M580 441 H618 V797 H320 V813" marker-end="url(#search-continuation-arrow)" />
  <text class="svg-small" x="340" y="789">Valid continuation</text>
  <path class="svg-connector" d="M580 441 H608 V988 H320 V1004" marker-end="url(#search-continuation-arrow)" />
  <text class="svg-small" x="340" y="980">Failure / changed binding</text>
  <DiagramCard x={60} y={20} width={520} title={"Authenticated Control Search"} tone="core" lines={["Current permissions and explicit", "filters apply before retrieval"]} />
  <DiagramCard x={60} y={188} width={520} title={"Existing lexical cursor"} lines={["Keep lexical continuation", "Provider recovery does not switch it to hybrid search"]} />
  <DiagramCard x={60} y={356} width={240} title={["Fresh query without", "a cursor"]} tone="core" lines={["Check hybrid eligibility", "Ready index and valid", "query vector are required"]} />
  <DiagramCard x={340} y={356} width={240} title={["Existing hybrid", "cursor"]} tone="core" lines={["Check caller, query", "and ranking binding", "Verify generation and", "vector fingerprint"]} />
  <DiagramCard x={60} y={596} width={240} title={["Keyword-ranked", "results"]} tone="authority" lines={["Continue lexical ranking", "Or use classified", "fresh-query fallback"]} />
  <DiagramCard x={340} y={596} width={240} title={"New hybrid results"} tone="authority" lines={["Hybrid index and", "vector usable", "An empty hybrid", "result is valid"]} />
  <DiagramCard x={60} y={813} width={520} title={"Continue existing hybrid ranking"} tone="authority" lines={["Same bound query, cursor and durable ranking", "Failure cannot switch an existing", "hybrid cursor to keyword ranking"]} />
  <DiagramCard x={60} y={1004} width={520} title={"Retry or restart"} tone="warning" lines={["Dependency failure: retry or restart", "Changed binding or generation: restart"]} />
  <DiagramCard x={60} y={1172} width={520} title={["Preserve unclassified errors and", "cancellation"]} tone="warning" lines={["Only classified indexing, provider or", "work-limit failures permit fresh-query fallback", "Public discovery has separate", "immutable snapshot inputs and limits"]} />

</svg>
</div>
