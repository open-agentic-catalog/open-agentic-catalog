---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="revision-lifecycle-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 330" role="img" aria-labelledby="revision-lifecycle-title revision-lifecycle-desc">
  <title id="revision-lifecycle-title">A review decision is final; publication is separate</title>
  <desc id="revision-lifecycle-desc">A submission freezes the selected content, listing and validation evidence. An independent reviewer approves, requests changes or rejects. Each decision is terminal for that submission. First approval seals the version label. Approval permits a separate publish command; it does not publish automatically.</desc>
  <defs><marker id="revision-lifecycle-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M190 100 H235" marker-end="url(#revision-lifecycle-arrow)" />
  <path class="svg-connector" d="M320 140 V185 H105 V240" marker-end="url(#revision-lifecycle-arrow)" />
  <path class="svg-connector" d="M320 140 V240" marker-end="url(#revision-lifecycle-arrow)" />
  <path class="svg-connector" d="M320 140 V185 H535 V240" marker-end="url(#revision-lifecycle-arrow)" />
  <text class="svg-title" x="320" y="30" text-anchor="middle">One submission; one terminal decision</text>
  <g><rect class="svg-node" x="20" y="60" width="170" height="80" rx="10" />
<text class="svg-title" x="105.0" y="84.0" text-anchor="middle">Candidate</text>
<text class="svg-copy" x="105.0" y="106.0" text-anchor="middle">Content + listing</text>
<text class="svg-copy" x="105.0" y="128.0" text-anchor="middle">+ validation</text></g>
  <g><rect class="svg-node-core" x="235" y="60" width="170" height="80" rx="10" />
<text class="svg-title" x="320.0" y="95.0" text-anchor="middle">Submit review</text>
<text class="svg-copy" x="320.0" y="117.0" text-anchor="middle">Independent review</text></g>
  <g><rect class="svg-node-authority" x="20" y="240" width="170" height="65" rx="10" />
<text class="svg-title" x="105.0" y="267.5" text-anchor="middle">Approved</text>
<text class="svg-copy" x="105.0" y="289.5" text-anchor="middle">Seals version</text></g>
  <g><rect class="svg-node" x="235" y="240" width="170" height="65" rx="10" />
<text class="svg-small" x="320.0" y="267.5" text-anchor="middle">Changes required</text>
<text class="svg-copy" x="320.0" y="289.5" text-anchor="middle">New submission</text></g>
  <g><rect class="svg-node" x="450" y="240" width="170" height="65" rx="10" />
<text class="svg-title" x="535.0" y="267.5" text-anchor="middle">Rejected</text>
<text class="svg-copy" x="535.0" y="289.5" text-anchor="middle">Reason retained</text></g>
</svg>
</div>
