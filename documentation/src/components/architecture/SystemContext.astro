---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---
<div class="catalog-architecture" role="region" aria-labelledby="system-context-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 490" role="img" aria-labelledby="system-context-title system-context-desc">
  <title id="system-context-title">People and systems around the Catalog</title>
  <desc id="system-context-desc">Clients use the Catalog. The Catalog verifies identity, retrieves approved metadata and packages, and can request embeddings or send webhooks. Git and OCI references identify external artifacts without implying a network request.</desc>
  <defs><marker id="system-context-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M150 95 V145 H280 V200" marker-end="url(#system-context-arrow)" />
  <text class="svg-small" x="26" y="179">Use the Catalog</text>
  <path class="svg-connector" d="M360 200 V145 H490 V95" marker-end="url(#system-context-arrow)" />
  <text class="svg-small" x="438" y="179">Keys / metadata</text>
  <path class="svg-connector svg-connector-reference" d="M220 248 H200" marker-end="url(#system-context-arrow)" />
  <text class="svg-small" x="28" y="314">References</text>
  <path class="svg-connector" d="M420 248 H440" marker-end="url(#system-context-arrow)" />
  <text class="svg-small" x="458" y="324">Embed</text>
  <path class="svg-connector" d="M280 301 V340 H150 V390" marker-end="url(#system-context-arrow)" />
  <text class="svg-small" x="36" y="356">Fetch</text>
  <path class="svg-connector" d="M360 301 V340 H490 V390" marker-end="url(#system-context-arrow)" />
  <text class="svg-small" x="548" y="356">Notify</text>
  <DiagramCard x={20} y={20} width={260} title="People and clients" lines={["UI, CLI, SDKs and IDEs"]} />
  <DiagramCard x={360} y={20} width={260} title="Identity provider" tone="external" lines={["Configured OIDC issuer"]} />
  <DiagramCard x={20} y={210} width={180} title="Git and OCI" tone="external" lines={["Artifact references"]} />
  <DiagramCard x={220} y={200} width={200} title={["Open Agentic", "Catalog"]} tone="core" lines={["Govern metadata"]} />
  <DiagramCard x={440} y={200} width={180} title={["Embedding", "provider"]} tone="optional" lines={["Optional inference"]} />
  <DiagramCard x={20} y={390} width={260} title="Approved sources" tone="external" lines={["Metadata and packages"]} />
  <DiagramCard x={360} y={390} width={260} title="Webhook receivers" tone="optional" lines={["Optional notifications"]} />
</svg>
</div>
