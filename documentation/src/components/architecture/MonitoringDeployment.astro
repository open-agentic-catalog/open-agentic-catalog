---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="monitoring-deployment-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 520" role="img" aria-labelledby="monitoring-deployment-title monitoring-deployment-desc">
  <title id="monitoring-deployment-title">Connect the optional monitoring release</title>
  <desc id="monitoring-deployment-desc">The separate optional monitoring release contains Prometheus and Grafana. Prometheus discovers Pods through the Kubernetes API and scrapes each API and worker Pod directly. Grafana queries Prometheus. Operators open Grafana through a private route or loopback port-forward. Monitoring is independent of application readiness.</desc>
  <defs><marker id="monitoring-deployment-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" /></marker></defs>

  <rect class="svg-boundary" x="20" y="20" width="600" height="150" rx="14" />
  <text class="svg-title" x="40" y="53">Application release</text>
  <rect class="svg-boundary-neutral" x="20" y="225" width="600" height="145" rx="14" />
  <text class="svg-title" x="350" y="258">Optional monitoring</text>

  <path class="svg-connector" d="M120 280 V145" marker-end="url(#monitoring-deployment-arrow)" />
  <text class="svg-small" x="134" y="207">Scrape</text>
  <path class="svg-connector" d="M240 280 V194 H475 V145" marker-end="url(#monitoring-deployment-arrow)" />
  <text class="svg-small" x="374" y="184">Scrape</text>
  <path class="svg-connector" d="M350 312 H280" marker-end="url(#monitoring-deployment-arrow)" />
  <text class="svg-small" x="290" y="299">Query</text>
  <path class="svg-connector" d="M165 345 V430" marker-end="url(#monitoring-deployment-arrow)" />
  <text class="svg-small" x="180" y="405">Discover Pods</text>
  <path class="svg-connector" d="M475 430 V345" marker-end="url(#monitoring-deployment-arrow)" />
  <text class="svg-small" x="490" y="405">Open UI</text>

  <rect class="svg-node-core" x="40" y="80" width="250" height="65" rx="12" />
  <text class="svg-title" x="56" y="107">API Pods</text>
  <text class="svg-copy" x="56" y="132">:8080/metrics</text>
  <rect class="svg-node-core" x="350" y="80" width="250" height="65" rx="12" />
  <text class="svg-title" x="366" y="107">Worker Pods</text>
  <text class="svg-copy" x="366" y="132">:9090/metrics</text>
  <rect class="svg-node" x="50" y="280" width="230" height="65" rx="12" />
  <text class="svg-title" x="66" y="319">Prometheus</text>
  <rect class="svg-node" x="350" y="280" width="250" height="65" rx="12" />
  <text class="svg-title" x="366" y="319">Grafana</text>
  <rect class="svg-node-external" x="50" y="430" width="230" height="65" rx="12" />
  <text class="svg-title" x="66" y="457">Kubernetes API</text>
  <text class="svg-copy" x="66" y="482">Scraper's own identity</text>
  <rect class="svg-node-external" x="350" y="430" width="250" height="65" rx="12" />
  <text class="svg-title" x="366" y="457">Operator browser</text>
  <text class="svg-copy" x="366" y="482">Loopback port-forward</text>
</svg>
</div>
