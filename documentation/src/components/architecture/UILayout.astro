---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="ui-layout-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 836" role="img" aria-labelledby="ui-layout-title ui-layout-desc">
  <title id="ui-layout-title">Catalog UI source layout</title>
  <desc id="ui-layout-desc">The catalog-ui directory contains browser source in src and the Go entry point in cmd/catalog-ui. The internal directory contains hosting and authentication code. The catalog-ui directory also contains development scripts, the frontend package manifest and lockfile, and README instructions. These are source ownership groups, not independently deployed microservices.</desc>
  <defs><marker id="ui-layout-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 95 V130 H180 V165" marker-end="url(#ui-layout-arrow)" />
  <path class="svg-connector" d="M320 95 V130 H460 V165" marker-end="url(#ui-layout-arrow)" />
  <path class="svg-connector" d="M320 95 V149 H12 V317 H180 V333" marker-end="url(#ui-layout-arrow)" />
  <DiagramCard x={60} y={20} width={520} title={"catalog-ui/"} tone="core" lines={["Browser client and Go authentication host"]} />
  <DiagramCard x={60} y={165} width={240} title={"src/"} tone="core" lines={["Routes, components,", "API client and styles"]} />
  <DiagramCard x={340} y={165} width={240} title={"cmd/catalog-ui/"} tone="core" lines={["Small Go host entry point"]} />
  <DiagramCard x={60} y={333} width={240} title={"internal/"} tone="core" lines={["Hosting, sessions", "and API forwarding"]} />
  <DiagramCard x={340} y={333} width={240} title={"scripts/"} lines={["Local launcher and", "generated API type checks"]} />
  <DiagramCard x={60} y={501} width={240} title={["package.json +", "lockfile"]} lines={["Frontend commands and", "pinned dependencies"]} />
  <DiagramCard x={340} y={501} width={240} title={"README.md"} lines={["Colocated development", "instructions"]} />
  <DiagramCard x={60} y={695} width={520} title={"Source ownership groups, not microservices"} tone="warning" lines={["Development support stays in the same directory", "The UI runs as one optional host,", "separate from API and worker"]} />

</svg>
</div>
