---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="testing-pyramid-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 440" role="img" aria-labelledby="testing-pyramid-title testing-pyramid-desc">
  <title id="testing-pyramid-title">Choose the test boundary</title>
  <desc id="testing-pyramid-desc">Read upward from isolated units through local functional tests, PostgreSQL integration, packaged end-to-end tests and deployment qualification. Higher layers add real boundaries and setup. Pyramid width shows preferred emphasis, not measured test counts or coverage.</desc>
  <polygon class="svg-node-core" points="250,20 390,20 428,90 212,90" />
  <text class="svg-title" x="320" y="63" text-anchor="middle">Deployment</text>
  <polygon class="svg-node" points="212,90 428,90 466,160 174,160" />
  <text class="svg-title" x="320" y="133" text-anchor="middle">Packaged E2E</text>
  <polygon class="svg-node-core" points="174,160 466,160 504,230 136,230" />
  <text class="svg-title" x="320" y="203" text-anchor="middle">PostgreSQL integration</text>
  <polygon class="svg-node" points="136,230 504,230 542,300 98,300" />
  <text class="svg-title" x="320" y="273" text-anchor="middle">Local functional</text>
  <polygon class="svg-node-core" points="98,300 542,300 580,370 60,370" />
  <text class="svg-title" x="320" y="343" text-anchor="middle">Isolated units</text>
  <text class="svg-copy" x="60" y="404">Higher layers add real boundaries and setup.</text>
</svg>
</div>
