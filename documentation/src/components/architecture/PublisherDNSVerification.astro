---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="publisher-dns-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 734" role="img" aria-labelledby="publisher-dns-title publisher-dns-desc">
  <title id="publisher-dns-title">Publisher DNS verification</title>
  <desc id="publisher-dns-desc">A Publisher manager requests a challenge for an exact declared domain. A DNS operator adds the returned TXT value. The manager starts a synchronous check. The API queries its system resolver and records the result. A match records proof and consumes the challenge. A failed renewal preserves earlier proof until expiry. Approval remains a separate command. DNS verification is disabled by default.</desc>
  <defs><marker id="publisher-dns-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 118 V188" marker-end="url(#publisher-dns-arrow)" />
  <path class="svg-connector" d="M320 309 V379" marker-end="url(#publisher-dns-arrow)" />
  <path class="svg-connector" d="M320 500 V535 H180 V570" marker-end="url(#publisher-dns-arrow)" />
  <path class="svg-connector" d="M320 500 V535 H460 V570" marker-end="url(#publisher-dns-arrow)" />
  <DiagramCard x={60} y={20} width={520} title="1. Request a challenge" tone="core" lines={["Publisher manager uses the Catalog API", "Keep the returned record name and value"]} />
  <DiagramCard x={60} y={188} width={520} title="2. Add the DNS TXT record" tone="external" lines={["DNS operator updates the exact DNS record", "The Catalog never changes DNS", "Wait for the record to become available"]} />
  <DiagramCard x={60} y={379} width={520} title="3. Check the DNS record" tone="core" lines={["Publisher manager selects Check DNS", "The API queries its system resolver", "One synchronous check; no worker Job"]} />
  <DiagramCard x={60} y={570} width={240} title="Matched record" tone="authority" lines={["Record proof for the", "exact declared domain", "Consume the challenge", "Approval stays separate"]} />
  <DiagramCard x={340} y={570} width={240} title="Negative check" tone="warning" lines={["Record the outcome", "A failed renewal keeps", "earlier proof until", "that proof expires"]} />
</svg>
</div>
