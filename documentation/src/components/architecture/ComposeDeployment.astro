---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="compose-deployment-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 1475" role="img" aria-labelledby="compose-deployment-title compose-deployment-desc">
  <title id="compose-deployment-title">Local Compose containers, ports and startup order</title>
  <desc id="compose-deployment-desc">The local Compose project contains PostgreSQL, a one-shot migration, one-shot development identity provisioning, API and worker containers, and an optional separately imaged UI. Default published host bindings are loopback-only: API 8080 to 8080, UI 4180 to 8080, PostgreSQL 55432 to 5432. Worker operations use container port 9090 without a host publication. Dotted startup dependencies differ from solid runtime requests and storage writes. PostgreSQL uses the persistent catalog-postgres-18 volume. Optional embedding and monitoring overlays are separate from this default topology.</desc>
  <defs><marker id="compose-deployment-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <rect class="svg-boundary" x="36" y="180" width="568" height="1250" rx="18" />
  <text class="svg-kicker" x="60" y="210">COMPOSE PROJECT</text>
  <path class="svg-connector" d="M580 70 H616 V310 H580" marker-end="url(#compose-deployment-arrow)" />
  <text class="svg-small" x="450" y="170">UI :4180</text>
  <path class="svg-connector" d="M60 70 H16 V550 H60" marker-end="url(#compose-deployment-arrow)" />
  <text class="svg-small" x="30" y="435">API :8080</text>
  <path class="svg-connector" d="M580 50 H628 V1145 H580" marker-end="url(#compose-deployment-arrow)" />
  <text class="svg-small" x="440" y="1010">Host DB :55432</text>
  <path class="svg-connector" d="M180 381 V500" marker-end="url(#compose-deployment-arrow)" />
  <text class="svg-small" x="198" y="438">API requests</text>
  <path class="svg-connector svg-connector-authority" d="M60 575 H46 V1110 H60" marker-end="url(#compose-deployment-arrow)" />
  <path class="svg-connector svg-connector-authority" d="M580 575 H596 V1110 H580" marker-end="url(#compose-deployment-arrow)" />
  <path class="svg-connector svg-connector-dependency" d="M180 1050 V858" marker-end="url(#compose-deployment-arrow)" />
  <text class="svg-small" x="200" y="968">Healthy</text>
  <path class="svg-connector svg-connector-dependency" d="M300 809 H340" marker-end="url(#compose-deployment-arrow)" />
  <text class="svg-small" x="303" y="797">Then</text>
  <path class="svg-connector svg-connector-dependency" d="M460 760 V680 H180 V621" marker-end="url(#compose-deployment-arrow)" />
  <path class="svg-connector svg-connector-dependency" d="M460 760 V621" marker-end="url(#compose-deployment-arrow)" />
  <text class="svg-small" x="480" y="700">Success</text>
  <path class="svg-connector svg-connector-authority" d="M320 1197 V1290" marker-end="url(#compose-deployment-arrow)" />
  <text class="svg-small" x="338" y="1250">Persist data</text>
  <DiagramCard x={60} y={20} width={520} title={"Local clients on the host"} lines={["Published bindings use 127.0.0.1; these are local defaults"]} />
  <DiagramCard x={60} y={260} width={520} title={"ui (optional)"} lines={["Host 127.0.0.1:4180; container HTTP :8080", "Separate UI image; no database access", "Starts after API is healthy"]} tone={"optional"} />
  <DiagramCard x={60} y={500} width={240} title={"api"} lines={["catalogd api", "Host 127.0.0.1:8080", "Container HTTP :8080"]} tone={"core"} />
  <DiagramCard x={340} y={500} width={240} title={"worker"} lines={["catalogd worker", "Operations :9090 only", "No published host port"]} tone={"core"} />
  <DiagramCard x={60} y={760} width={240} title={"migrate (one-shot)"} lines={["Apply schema and grants", "Schema-owner credential"]} />
  <DiagramCard x={340} y={760} width={240} title={"provision (one-shot)"} lines={["Provision dev identities", "Schema-owner credential"]} />
  <DiagramCard x={60} y={1050} width={520} title={"postgres"} lines={["PostgreSQL 18 + pgcrypto", "Host 127.0.0.1:55432; container :5432", "Separate owner, API and worker credentials"]} kicker={"DATABASE CONTAINER"} tone={"authority"} />
  <DiagramCard x={60} y={1290} width={520} title={"PostgreSQL data volume"} lines={["catalog-postgres-18", "Survives stop and normal down"]} tone={"authority"} />
  <text class="svg-small" x="20" y="1455">Solid: requests/storage. Dotted: startup dependencies, not requests.</text>
</svg>
</div>
