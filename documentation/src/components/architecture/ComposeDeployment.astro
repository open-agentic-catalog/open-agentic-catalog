---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---
<div class="catalog-architecture" role="region" aria-labelledby="compose-deployment-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 590" role="img" aria-labelledby="compose-deployment-title compose-deployment-desc">
  <title id="compose-deployment-title">Local Compose containers and access</title>
  <desc id="compose-deployment-desc">Local clients reach the optional UI on loopback 4180 and the API on loopback 8080. API and worker connect to PostgreSQL, whose loopback binding is 55432. The worker operations port stays private. Migration and provisioning complete before runtime startup. The database volume survives normal stops and down.</desc>
  <defs><marker id="compose-deployment-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <rect class="svg-boundary" x="10" y="130" width="620" height="445" rx="16" />
  <text class="svg-title" x="380" y="162">OAC Compose project</text>
  <path class="svg-connector" d="M110 95 V195" marker-end="url(#compose-deployment-arrow)" />
  <text class="svg-small" x="122" y="117">UI</text>
  <path class="svg-connector" d="M330 95 V195" marker-end="url(#compose-deployment-arrow)" />
  <text class="svg-small" x="342" y="117">API</text>
  <path class="svg-connector" d="M200 244 H240" marker-end="url(#compose-deployment-arrow)" />
  <path class="svg-connector" d="M330 293 V365" marker-end="url(#compose-deployment-arrow)" />
  <text class="svg-small" x="250" y="337">API SQL</text>
  <path class="svg-connector" d="M530 293 V330 H390 V365" marker-end="url(#compose-deployment-arrow)" />
  <text class="svg-small" x="442" y="318">Worker SQL</text>
  <path class="svg-connector" d="M420 403 H440" marker-end="url(#compose-deployment-arrow)" />
  <DiagramCard x={20} y={20} width={600} title="Local browser and clients" lines={["127.0.0.1: UI 4180 | API 8080 | PostgreSQL 55432"]} />
  <DiagramCard x={20} y={195} width={180} title="ui" tone="optional" lines={["Optional Go host", ":8080"]} />
  <DiagramCard x={240} y={195} width={180} title="api" tone="core" lines={["catalogd api", ":8080"]} />
  <DiagramCard x={440} y={195} width={180} title="worker" tone="core" lines={["catalogd worker", "Private :9090"]} />
  <DiagramCard x={240} y={365} width={180} title="postgres" tone="authority" lines={["18 + pgcrypto"]} />
  <DiagramCard x={440} y={365} width={180} title="Data volume" tone="authority" lines={["Retained on stop"]} />
  <text class="svg-small" x="30" y="480">Startup order</text>
  <rect class="svg-node" x="20" y="505" width="130" height="40" rx="8" />
  <rect class="svg-node" x="175" y="505" width="130" height="40" rx="8" />
  <rect class="svg-node" x="330" y="505" width="130" height="40" rx="8" />
  <rect class="svg-node" x="485" y="505" width="130" height="40" rx="8" />
  <text class="svg-small" x="85" y="531" text-anchor="middle">postgres</text>
  <text class="svg-small" x="240" y="531" text-anchor="middle">migrate</text>
  <text class="svg-small" x="395" y="531" text-anchor="middle">provision</text>
  <text class="svg-small" x="550" y="531" text-anchor="middle">API / worker</text>
  <path class="svg-connector svg-connector-dependency" d="M150 525 H175" marker-end="url(#compose-deployment-arrow)" />
  <path class="svg-connector svg-connector-dependency" d="M305 525 H330" marker-end="url(#compose-deployment-arrow)" />
  <path class="svg-connector svg-connector-dependency" d="M460 525 H485" marker-end="url(#compose-deployment-arrow)" />
</svg>
</div>
