---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="edit-choices-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 1146" role="img" aria-labelledby="edit-choices-title edit-choices-desc">
  <title id="edit-choices-title">Choose how to correct metadata or native content</title>
  <desc id="edit-choices-desc">A listing-only correction keeps the exact VersionRevision. Unsealed native content can receive a new revision under its version label. Sealed native content requires a new version label. Each path creates an exact listing revision for a fresh independent review before release publication. Revalidation appends evidence and never rewrites content; a stale pending submission needs a terminal review decision before replacement.</desc>
  <defs><marker id="edit-choices-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M320 95 V165" marker-end="url(#edit-choices-arrow)" />
  <path class="svg-connector" d="M320 95 V149 H12 V317 H320 V333" marker-end="url(#edit-choices-arrow)" />
  <path class="svg-connector" d="M320 95 V119 H628 V485 H320 V501" marker-end="url(#edit-choices-arrow)" />
  <path class="svg-connector" d="M320 263 V287 H22 V653 H320 V669" marker-end="url(#edit-choices-arrow)" />
  <path class="svg-connector" d="M320 431 V455 H618 V623 H320 V669" marker-end="url(#edit-choices-arrow)" />
  <path class="svg-connector" d="M320 599 V669" marker-end="url(#edit-choices-arrow)" />
  <path class="svg-connector" d="M320 767 V837" marker-end="url(#edit-choices-arrow)" />
  <DiagramCard x={60} y={20} width={520} title={"What needs correction?"} tone="core" lines={["Preserve immutable content and retained evidence"]} />
  <DiagramCard x={60} y={165} width={520} title={"Only listing metadata"} lines={["Keep the exact VersionRevision", "No new version label"]} />
  <DiagramCard x={60} y={333} width={520} title={"Unsealed native content"} lines={["Create a new content revision", "Keep the existing version label"]} />
  <DiagramCard x={60} y={501} width={520} title={"Sealed native content"} lines={["Create a new version label", "Keep the sealed revision unchanged"]} />
  <DiagramCard x={60} y={669} width={520} title={"New exact ListingRevision"} lines={["Bind the selected content", "revision and new listing metadata"]} />
  <DiagramCard x={60} y={837} width={520} title={"Submit, independently review and publish"} tone="authority" lines={["Each correction needs fresh review", "bound to exact retained evidence"]} />
  <DiagramCard x={60} y={1005} width={520} title={"Revalidation adds evidence"} tone="warning" lines={["It does not correct retained content", "A stale pending submission needs a", "terminal decision before replacement"]} />

</svg>
</div>
