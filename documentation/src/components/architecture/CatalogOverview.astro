---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---
<div class="catalog-architecture" role="region" aria-labelledby="catalog-overview-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 300" role="img" aria-labelledby="catalog-overview-title catalog-overview-desc">
  <title id="catalog-overview-title">From authored or federated metadata to discovery</title>
  <desc id="catalog-overview-desc">Authors prepare revisions, reviewers approve evidence, and publishers release listings. Catalog readers search those releases and metadata from approved sources. Host discovery also requires separate snapshot activation.</desc>
  <defs><marker id="catalog-overview-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M200 58 H230" marker-end="url(#catalog-overview-arrow)" />
  <path class="svg-connector" d="M410 58 H440" marker-end="url(#catalog-overview-arrow)" />
  <path class="svg-connector" d="M530 95 V200" marker-end="url(#catalog-overview-arrow)" />
  <text class="svg-small" x="398" y="152">Catalog reads</text>
  <path class="svg-connector" d="M290 238 H440" marker-end="url(#catalog-overview-arrow)" />
  <text class="svg-small" x="326" y="222">Federate</text>
  <DiagramCard x={20} y={20} width={180} title="Author" lines={["Prepare revisions"]} />
  <DiagramCard x={230} y={20} width={180} title="Review" lines={["Approve evidence"]} />
  <DiagramCard x={440} y={20} width={180} title="Release" tone="core" lines={["Publish a listing"]} />
  <DiagramCard x={20} y={200} width={270} title="Approved sources" tone="external" lines={["Keep source provenance"]} />
  <DiagramCard x={440} y={200} width={180} title="Discover" tone="core" lines={["Search and browse"]} />
</svg>
</div>
