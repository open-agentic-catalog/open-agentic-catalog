---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="catalog-mcp-connections-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 430" role="img" aria-labelledby="catalog-mcp-connections-title catalog-mcp-connections-desc">
  <title id="catalog-mcp-connections-title">Stdio and HTTP reach the same authorized reads</title>
  <desc id="catalog-mcp-connections-desc">A local MCP host starts catalogctl mcp serve, which sends token-authenticated Control HTTP reads. A remote MCP host calls the enabled API /mcp endpoint with its own token. Both API entry points call shared authorized reads in process. They do not connect to cataloged MCP Servers.</desc>
  <defs><marker id="catalog-mcp-connections-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <rect class="svg-boundary" x="220" y="185" width="410" height="225" rx="14" />
  <text class="svg-title" x="450" y="209" text-anchor="middle">Catalog API</text>
  <path class="svg-connector" d="M190 80 H235" marker-end="url(#catalog-mcp-connections-arrow)" />
  <text class="svg-copy" x="212" y="40" text-anchor="middle">stdio</text>
  <path class="svg-connector" d="M320 115 V235" marker-end="url(#catalog-mcp-connections-arrow)" />
  <text class="svg-copy" x="330" y="166" text-anchor="start">Control HTTP + CLI token</text>
  <path class="svg-connector" d="M190 345 H235" marker-end="url(#catalog-mcp-connections-arrow)" />
  <text class="svg-copy" x="126" y="303" text-anchor="middle">MCP HTTP + caller token</text>
  <path class="svg-connector" d="M405 260 H425 V295 H450" marker-end="url(#catalog-mcp-connections-arrow)" />
  <path class="svg-connector" d="M405 345 H425 V295 H450" marker-end="url(#catalog-mcp-connections-arrow)" />
  <g><rect class="svg-node" x="20" y="45" width="170" height="70" rx="10" />
<text class="svg-small" x="105.0" y="86.0" text-anchor="middle">Local MCP host</text></g>
  <g><rect class="svg-node" x="235" y="45" width="170" height="70" rx="10" />
<text class="svg-title" x="320.0" y="75.0" text-anchor="middle">catalogctl</text>
<text class="svg-copy" x="320.0" y="97.0" text-anchor="middle">mcp serve</text></g>
  <g><rect class="svg-node" x="235" y="235" width="170" height="50" rx="10" />
<text class="svg-title" x="320.0" y="255.0" text-anchor="middle">/api/v1</text>
<text class="svg-copy" x="320.0" y="277.0" text-anchor="middle">Control reads</text></g>
  <g><rect class="svg-node" x="20" y="310" width="170" height="70" rx="10" />
<text class="svg-title" x="105.0" y="351.0" text-anchor="middle">HTTP MCP host</text></g>
  <g><rect class="svg-node-optional" x="235" y="320" width="170" height="50" rx="10" />
<text class="svg-title" x="320.0" y="340.0" text-anchor="middle">/mcp</text>
<text class="svg-copy" x="320.0" y="362.0" text-anchor="middle">Optional HTTP MCP</text></g>
  <g><rect class="svg-node-authority" x="450" y="260" width="170" height="70" rx="10" />
<text class="svg-title" x="535.0" y="290.0" text-anchor="middle">Shared reads</text>
<text class="svg-copy" x="535.0" y="312.0" text-anchor="middle">Current permissions</text></g>
</svg>
</div>
