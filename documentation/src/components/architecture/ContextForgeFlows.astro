---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---

<div class="catalog-architecture" role="region" aria-labelledby="contextforge-flows-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 865" role="img" aria-labelledby="contextforge-flows-title contextforge-flows-desc">
  <title id="contextforge-flows-title">Catalog metadata and ContextForge runtime connections</title>
  <desc id="contextforge-flows-desc">The first flow searches Catalog metadata. An MCP client authenticates to a ContextForge virtual server with a ContextForge token. Its Gateway uses a configured Catalog Reader token to call the Catalog API's read-only MCP tools. The second flow discovers and uses a virtual server. catalogctl reads a governed Server Card through the Control API with a Catalog credential. A purple dashed arrow carries the endpoint reference into explicit client setup, not a request or credential. An independent MCP client supplies a separate ContextForge token and calls the virtual server. ContextForge forwards requests to Everything with its upstream test key. The Catalog does not invoke that server. This released Server Card contains no runtime token.</desc>
  <defs><marker id="contextforge-flows-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <text class="svg-title" x="60" y="40">1. Search metadata</text>
  <text class="svg-title" x="340" y="40">2. Discover and use</text>
  <path class="svg-connector" d="M180 165 V235" marker-end="url(#contextforge-flows-arrow)" />
  <text class="svg-small" x="192" y="202">ContextForge token</text>
  <path class="svg-connector" d="M180 336 V406" marker-end="url(#contextforge-flows-arrow)" />
  <text class="svg-small" x="192" y="373">Catalog Reader token</text>
  <path class="svg-connector" d="M460 165 V235" marker-end="url(#contextforge-flows-arrow)" />
  <text class="svg-small" x="472" y="202">Catalog credential</text>
  <path class="svg-connector svg-connector-reference" d="M460 333 V403" marker-end="url(#contextforge-flows-arrow)" />
  <text class="svg-small" x="472" y="370">Endpoint reference</text>
  <path class="svg-connector" d="M460 527 V597" marker-end="url(#contextforge-flows-arrow)" />
  <text class="svg-small" x="472" y="564">ContextForge token</text>
  <path class="svg-connector" d="M460 698 V768" marker-end="url(#contextforge-flows-arrow)" />
  <text class="svg-small" x="472" y="735">Upstream test key</text>
  <DiagramCard x={60} y={90} width={240} title="MCP client" lines={["Select Catalog tools"]} />
  <DiagramCard x={60} y={235} width={240} title={["ContextForge", "virtual server"]} lines={["Gateway forwards calls"]} />
  <DiagramCard x={60} y={406} width={240} title="Catalog API /mcp" tone="core" lines={["Six read-only tools", "Return Catalog metadata", "No resource invocation"]} />
  <DiagramCard x={60} y={597} width={240} title={["Metadata does not", "grant runtime access"]} tone="warning" lines={["Catalog and runtime", "credentials stay separate", "The released card has", "no runtime token"]} />
  <DiagramCard x={340} y={90} width={240} title="catalogctl" lines={["Search and read a release"]} />
  <DiagramCard x={340} y={235} width={240} title="Catalog Control API" tone="core" lines={["Return the released", "Server Card and endpoint"]} />
  <DiagramCard x={340} y={403} width={240} title={["Independent", "MCP client"]} lines={["Explicit client setup", "Add ContextForge token"]} />
  <DiagramCard x={340} y={597} width={240} title={["ContextForge", "virtual server"]} lines={["Separate runtime access"]} />
  <DiagramCard x={340} y={768} width={240} title="Everything MCP" tone="external" lines={["Echo and static resources"]} />
</svg>
</div>
