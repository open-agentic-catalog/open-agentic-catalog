---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="scoped-access-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 380" role="img" aria-labelledby="scoped-access-title scoped-access-desc">
  <title id="scoped-access-title">Permissions can arrive through more than one path</title>
  <desc id="scoped-access-desc">Within an active Catalog membership, applicable direct role assignments and current group memberships with group assignments contribute permissions for the requested tenant or exact namespace. Any enforced OAuth scope limits the combined result. Removing one path does not revoke another applicable path.</desc>
  <defs><marker id="scoped-access-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <text class="svg-title" x="20" y="28" text-anchor="start">Active Catalog membership</text>
  <path class="svg-connector" d="M190 95 H425 V165 H450" marker-end="url(#scoped-access-arrow)" />
  <path class="svg-connector" d="M190 245 H235" marker-end="url(#scoped-access-arrow)" />
  <path class="svg-connector" d="M405 245 H425 V165 H450" marker-end="url(#scoped-access-arrow)" />
  <path class="svg-connector" d="M535 200 V280" marker-end="url(#scoped-access-arrow)" />
  <text class="svg-copy" x="535" y="247" text-anchor="middle">Then apply</text>
  <g><rect class="svg-node" x="20" y="60" width="170" height="70" rx="10" />
<text class="svg-title" x="105.0" y="90.0" text-anchor="middle">Direct role</text>
<text class="svg-copy" x="105.0" y="112.0" text-anchor="middle">assignment</text></g>
  <g><rect class="svg-node" x="20" y="210" width="170" height="70" rx="10" />
<text class="svg-title" x="105.0" y="240.0" text-anchor="middle">Group member</text>
<text class="svg-copy" x="105.0" y="262.0" text-anchor="middle">Active membership</text></g>
  <g><rect class="svg-node" x="235" y="210" width="170" height="70" rx="10" />
<text class="svg-title" x="320.0" y="240.0" text-anchor="middle">Group role</text>
<text class="svg-copy" x="320.0" y="262.0" text-anchor="middle">assignment</text></g>
  <g><rect class="svg-node-authority" x="450" y="130" width="170" height="70" rx="10" />
<text class="svg-title" x="535.0" y="160.0" text-anchor="middle">Combine</text>
<text class="svg-copy" x="535.0" y="182.0" text-anchor="middle">permissions</text></g>
  <g><rect class="svg-node" x="450" y="280" width="170" height="70" rx="10" />
<text class="svg-title" x="535.0" y="310.0" text-anchor="middle">OAuth ceiling</text>
<text class="svg-copy" x="535.0" y="332.0" text-anchor="middle">When enforced</text></g>
</svg>
</div>
