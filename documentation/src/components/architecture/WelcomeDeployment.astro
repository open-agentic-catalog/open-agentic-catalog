---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---
<div class="catalog-architecture" role="region" aria-labelledby="welcome-deployment-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 430" role="img" aria-labelledby="welcome-deployment-title welcome-deployment-desc">
  <title id="welcome-deployment-title">Catalog processes and PostgreSQL connections</title>
  <desc id="welcome-deployment-desc">The optional browser client calls its Go UI host, which forwards to the API. CLI, SDK and IDE clients call the API directly. API and worker use separate PostgreSQL logins. The UI host and API contact the configured OIDC issuer when selected.</desc>
  <defs><marker id="welcome-deployment-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M110 95 V170" marker-end="url(#welcome-deployment-arrow)" />
  <text class="svg-small" x="122" y="143">Same origin</text>
  <path class="svg-connector" d="M320 95 V170" marker-end="url(#welcome-deployment-arrow)" />
  <text class="svg-small" x="334" y="143">Control API</text>
  <path class="svg-connector" d="M200 208 H235" marker-end="url(#welcome-deployment-arrow)" />
  <path class="svg-connector" d="M110 245 V330" marker-end="url(#welcome-deployment-arrow)" />
  <text class="svg-small" x="30" y="298">Login</text>
  <path class="svg-connector" d="M270 245 V285 H150 V330" marker-end="url(#welcome-deployment-arrow)" />
  <text class="svg-small" x="170" y="276">Keys</text>
  <path class="svg-connector" d="M340 245 V330" marker-end="url(#welcome-deployment-arrow)" />
  <text class="svg-small" x="354" y="298">API SQL</text>
  <path class="svg-connector" d="M530 245 V330" marker-end="url(#welcome-deployment-arrow)" />
  <text class="svg-small" x="438" y="298">Worker SQL</text>
  <DiagramCard x={20} y={20} width={180} title="Browser" tone="optional" lines={["React client"]} />
  <DiagramCard x={235} y={20} width={170} title="API clients" lines={["CLI, SDKs, IDEs"]} />
  <DiagramCard x={20} y={170} width={180} title="UI host" tone="optional" lines={["Go process"]} />
  <DiagramCard x={235} y={170} width={170} title="API" tone="core" lines={["catalogd api"]} />
  <DiagramCard x={440} y={170} width={180} title="Worker" tone="core" lines={["catalogd worker"]} />
  <DiagramCard x={20} y={330} width={180} title="OIDC issuer" tone="external" lines={["When configured"]} />
  <DiagramCard x={270} y={330} width={350} title="PostgreSQL 18 + pgcrypto" tone="authority" lines={["Catalog records, Jobs and outbox"]} />
</svg>
</div>
