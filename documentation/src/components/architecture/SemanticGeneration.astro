---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="semantic-generation-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 505" role="img" aria-labelledby="semantic-generation-title semantic-generation-desc">
  <title id="semantic-generation-title">Build a complete replacement index</title>
  <desc id="semantic-generation-desc">A leased generation pages eligible metadata, reuses compatible vectors or infers missing inputs, and saves a vector or permanent rejection for each member. Only complete verified membership becomes usable. Transient failures retry without replacing the old usable state.</desc>
  <defs><marker id="semantic-generation-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M200 75 H235" marker-end="url(#semantic-generation-arrow)" />
  <path class="svg-connector" d="M405 75 H440" marker-end="url(#semantic-generation-arrow)" />
  <path class="svg-connector" d="M530 115 V190" marker-end="url(#semantic-generation-arrow)" />
  <path class="svg-connector" d="M440 230 H405" marker-end="url(#semantic-generation-arrow)" />
  <path class="svg-connector" d="M235 230 H200" marker-end="url(#semantic-generation-arrow)" />
  <path class="svg-connector" d="M465 115 V170 H320 V190" marker-end="url(#semantic-generation-arrow)" />
  <path class="svg-connector" d="M110 190 V145 H320 V115" marker-end="url(#semantic-generation-arrow)" />
  <path class="svg-connector" d="M110 270 V440 H220" marker-end="url(#semantic-generation-arrow)" />
  <path class="svg-connector" d="M530 270 V350" marker-end="url(#semantic-generation-arrow)" />
  <text class="svg-small" x="545" y="163" text-anchor="start">Missing</text>
  <text class="svg-small" x="370" y="160" text-anchor="middle">Reuse</text>
  <text class="svg-small" x="166" y="171" text-anchor="middle">More pages</text>
  <text class="svg-small" x="150" y="346" text-anchor="middle">Complete</text>
  <text class="svg-small" x="515" y="312" text-anchor="end">Transient</text>
  <text class="svg-small" x="515" y="334" text-anchor="end">failure</text>
  <rect class="svg-node-core" x="20" y="30" width="180" height="85" rx="12" />
  <text class="svg-title" x="110" y="67.5" text-anchor="middle">Leased</text>
  <text class="svg-title" x="110" y="91.5" text-anchor="middle">generation</text>
  <rect class="svg-node" x="235" y="30" width="170" height="85" rx="12" />
  <text class="svg-title" x="320" y="67.5" text-anchor="middle">Read next</text>
  <text class="svg-title" x="320" y="91.5" text-anchor="middle">metadata page</text>
  <rect class="svg-node" x="440" y="30" width="180" height="85" rx="12" />
  <text class="svg-title" x="530" y="67.5" text-anchor="middle">Compatible</text>
  <text class="svg-title" x="530" y="91.5" text-anchor="middle">vectors?</text>
  <rect class="svg-node" x="20" y="190" width="180" height="80" rx="12" />
  <text class="svg-title" x="110" y="218" text-anchor="middle">All members?</text>
  <text class="svg-copy" x="110" y="242" text-anchor="middle">Lease + generation</text>
  <rect class="svg-node" x="235" y="190" width="170" height="80" rx="12" />
  <text class="svg-title" x="320" y="218" text-anchor="middle">Save member</text>
  <text class="svg-copy" x="320" y="242" text-anchor="middle">Vector or rejection</text>
  <rect class="svg-node" x="440" y="190" width="180" height="80" rx="12" />
  <text class="svg-title" x="530" y="218" text-anchor="middle">Run inference</text>
  <text class="svg-copy" x="530" y="242" text-anchor="middle">Outside SQL</text>
  <rect class="svg-node-warning" x="440" y="350" width="180" height="80" rx="12" />
  <text class="svg-title" x="530" y="378" text-anchor="middle">Retry Job</text>
  <text class="svg-copy" x="530" y="402" text-anchor="middle">Keep old index</text>
  <rect class="svg-node-authority" x="220" y="405" width="200" height="75" rx="12" />
  <text class="svg-title" x="320" y="437.5" text-anchor="middle">Serve verified</text>
  <text class="svg-title" x="320" y="461.5" text-anchor="middle">replacement</text>
</svg>
</div>
