---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="embedding-boundary-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 440" role="img" aria-labelledby="embedding-boundary-title embedding-boundary-desc">
  <title id="embedding-boundary-title">Query and indexing data sent to inference</title>
  <desc id="embedding-boundary-desc">API query text and worker metadata batches go to one optional embedding endpoint. Vectors return to their callers. API and worker access PostgreSQL separately; the provider has no database access.</desc>
  <defs><marker id="embedding-boundary-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M200 75 H250 V205 H265 V225" marker-end="url(#embedding-boundary-arrow)" />
  <path class="svg-connector" d="M245 225 H225 V135 H160 V110" marker-end="url(#embedding-boundary-arrow)" />
  <path class="svg-connector" d="M440 75 H390 V205 H375 V225" marker-end="url(#embedding-boundary-arrow)" />
  <path class="svg-connector" d="M395 225 H415 V135 H480 V110" marker-end="url(#embedding-boundary-arrow)" />
  <path class="svg-connector" d="M80 110 V385 H220" marker-end="url(#embedding-boundary-arrow)" />
  <path class="svg-connector" d="M560 110 V385 H420" marker-end="url(#embedding-boundary-arrow)" />
  <text class="svg-small" x="265" y="152" text-anchor="start">Query</text>
  <text class="svg-small" x="150" y="177" text-anchor="middle">Vector</text>
  <text class="svg-small" x="375" y="178" text-anchor="end">Metadata</text>
  <text class="svg-small" x="490" y="177" text-anchor="middle">Vectors</text>
  <text class="svg-small" x="89" y="326" text-anchor="start">Search vectors</text>
  <text class="svg-small" x="550" y="326" text-anchor="end">Index vectors</text>
  <rect class="svg-node-core" x="20" y="30" width="180" height="80" rx="12" />
  <text class="svg-title" x="110" y="58" text-anchor="middle">API</text>
  <text class="svg-copy" x="110" y="82" text-anchor="middle">Query inference</text>
  <rect class="svg-node-core" x="440" y="30" width="180" height="80" rx="12" />
  <text class="svg-title" x="530" y="58" text-anchor="middle">Worker</text>
  <text class="svg-copy" x="530" y="82" text-anchor="middle">Batch indexing</text>
  <rect class="svg-node-optional" x="220" y="225" width="200" height="90" rx="12" />
  <text class="svg-title" x="320" y="253" text-anchor="middle">Embedding</text>
  <text class="svg-title" x="320" y="277" text-anchor="middle">endpoint</text>
  <text class="svg-copy" x="320" y="301" text-anchor="middle">Optional; one model</text>
  <rect class="svg-node-authority" x="220" y="350" width="200" height="70" rx="12" />
  <text class="svg-title" x="320" y="378" text-anchor="middle">PostgreSQL</text>
  <text class="svg-copy" x="320" y="402" text-anchor="middle">Derived vectors</text>
</svg>
</div>
