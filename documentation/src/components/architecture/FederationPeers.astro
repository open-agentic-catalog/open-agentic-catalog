---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="federation-peers-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 440" role="img" aria-labelledby="federation-peers-title federation-peers-desc">
  <title id="federation-peers-title">Two Catalogs exchange published metadata</title>
  <desc id="federation-peers-desc">Catalog B requests indexed metadata or optional live Search results from Catalog A. Indexed observations persist in B; live results remain transient. Each Catalog keeps its own database and governance. B uses the source credential rather than its caller's token.</desc>
  <defs><marker id="federation-peers-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <rect class="svg-boundary-neutral" x="20" y="15" width="270" height="410" rx="14" />
  <rect class="svg-boundary-neutral" x="350" y="15" width="270" height="410" rx="14" />
  <text class="svg-title" x="155" y="48" text-anchor="middle">Catalog B</text>
  <text class="svg-title" x="485" y="48" text-anchor="middle">Catalog A</text>
  <path class="svg-connector" d="M260 95 H380" marker-end="url(#federation-peers-arrow)" />
  <path class="svg-connector" d="M380 120 H260" marker-end="url(#federation-peers-arrow)" />
  <text class="svg-small" x="320" y="82" text-anchor="middle">Fetch</text>
  <text class="svg-small" x="320" y="148" text-anchor="middle">Entries</text>
  <path class="svg-connector" d="M260 345 H380" marker-end="url(#federation-peers-arrow)" />
  <path class="svg-connector" d="M380 370 H260" marker-end="url(#federation-peers-arrow)" />
  <text class="svg-small" x="320" y="332" text-anchor="middle">Search</text>
  <text class="svg-small" x="320" y="398" text-anchor="middle">Results</text>
  <path class="svg-connector" d="M150 140 V190" marker-end="url(#federation-peers-arrow)" />
  <text class="svg-small" x="171" y="174" text-anchor="start">Retain</text>
  <path class="svg-connector" d="M490 140 V190" marker-end="url(#federation-peers-arrow)" />
  <text class="svg-small" x="508" y="174" text-anchor="start">Read</text>
  <path class="svg-connector" d="M490 320 V260" marker-end="url(#federation-peers-arrow)" />
  <text class="svg-small" x="507" y="296" text-anchor="start">Read</text>
  <rect class="svg-node" x="40" y="70" width="220" height="70" rx="12" />
  <text class="svg-title" x="150" y="98" text-anchor="middle">Indexed sync</text>
  <text class="svg-copy" x="150" y="122" text-anchor="middle">Worker</text>
  <rect class="svg-node-authority" x="40" y="190" width="220" height="70" rx="12" />
  <text class="svg-title" x="150" y="218" text-anchor="middle">B PostgreSQL</text>
  <text class="svg-copy" x="150" y="242" text-anchor="middle">External observations</text>
  <rect class="svg-node-optional" x="40" y="320" width="220" height="70" rx="12" />
  <text class="svg-title" x="150" y="348" text-anchor="middle">Live Search</text>
  <text class="svg-copy" x="150" y="372" text-anchor="middle">Optional; transient</text>
  <rect class="svg-node" x="380" y="70" width="220" height="70" rx="12" />
  <text class="svg-title" x="490" y="98" text-anchor="middle">Manifest / List</text>
  <text class="svg-copy" x="490" y="122" text-anchor="middle">Published metadata</text>
  <rect class="svg-node-authority" x="380" y="190" width="220" height="70" rx="12" />
  <text class="svg-title" x="490" y="218" text-anchor="middle">A PostgreSQL</text>
  <text class="svg-copy" x="490" y="242" text-anchor="middle">Active snapshot</text>
  <rect class="svg-node" x="380" y="320" width="220" height="70" rx="12" />
  <text class="svg-title" x="490" y="348" text-anchor="middle">ARD Search</text>
  <text class="svg-copy" x="490" y="372" text-anchor="middle">Host + audience</text>
</svg>
</div>
