---
import "../../styles/architecture.css";
---

<div class="catalog-architecture" role="region" aria-labelledby="browser-session-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 650" role="img" aria-labelledby="browser-session-title browser-session-desc">
  <title id="browser-session-title">Sign-in creates a host session; requests use it</title>
  <desc id="browser-session-desc">The browser follows authorization and callback redirects. The UI host validates state, exchanges the code using PKCE, checks token identity and calls GET /api/v1/me before setting its encrypted cookie. Later browser requests carry that cookie; the host checks request and CSRF defenses and forwards the access token to one API.</desc>
  <defs><marker id="browser-session-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <text class="svg-title" x="20" y="28" text-anchor="start">Sign in</text>
  <path class="svg-divider" d="M80 105 V445 M240 105 V445 M400 105 V445 M560 105 V445" />
  <path class="svg-connector" d="M80 135 H240" marker-end="url(#browser-session-arrow)" />
  <text class="svg-copy" x="160" y="123" text-anchor="middle">Start login</text>
  <path class="svg-connector" d="M240 175 H80" marker-end="url(#browser-session-arrow)" />
  <text class="svg-copy" x="160" y="163" text-anchor="middle">Authorize URL</text>
  <path class="svg-connector" d="M80 215 H400" marker-end="url(#browser-session-arrow)" />
  <text class="svg-copy" x="240" y="203" text-anchor="middle">Open provider</text>
  <path class="svg-connector" d="M400 255 H80" marker-end="url(#browser-session-arrow)" />
  <text class="svg-copy" x="240" y="243" text-anchor="middle">Callback URL</text>
  <path class="svg-connector" d="M80 295 H240" marker-end="url(#browser-session-arrow)" />
  <text class="svg-copy" x="160" y="283" text-anchor="middle">Code + state</text>
  <path class="svg-connector" d="M240 335 H400" marker-end="url(#browser-session-arrow)" />
  <text class="svg-copy" x="320" y="323" text-anchor="middle">Code exchange</text>
  <path class="svg-connector" d="M400 360 H240" marker-end="url(#browser-session-arrow)" />
  <text class="svg-copy" x="320" y="348" text-anchor="middle">Tokens</text>
  <path class="svg-connector svg-connector-authority" d="M240 395 H560" marker-end="url(#browser-session-arrow)" />
  <text class="svg-copy" x="400" y="383" text-anchor="middle">GET /api/v1/me</text>
  <path class="svg-connector" d="M240 430 H80" marker-end="url(#browser-session-arrow)" />
  <text class="svg-copy" x="160" y="418" text-anchor="middle">Set session cookie</text>
  <text class="svg-title" x="20" y="477" text-anchor="start">Authenticated request</text>
  <path class="svg-divider" d="M80 540 V635 M240 540 V635 M560 540 V635" />
  <path class="svg-connector" d="M80 575 H240" marker-end="url(#browser-session-arrow)" />
  <text class="svg-copy" x="160" y="563" text-anchor="middle">Cookie; write CSRF</text>
  <path class="svg-connector" d="M240 625 H560" marker-end="url(#browser-session-arrow)" />
  <text class="svg-copy" x="400" y="613" text-anchor="middle">Access token; fixed API</text>
  <g><rect class="svg-node" x="10" y="50" width="140" height="55" rx="10" />
<text class="svg-title" x="80.0" y="83.5" text-anchor="middle">Browser</text></g>
  <g><rect class="svg-node-core" x="170" y="50" width="140" height="55" rx="10" />
<text class="svg-title" x="240.0" y="83.5" text-anchor="middle">UI host</text></g>
  <g><rect class="svg-node-external" x="330" y="50" width="140" height="55" rx="10" />
<text class="svg-title" x="400.0" y="83.5" text-anchor="middle">Provider</text></g>
  <g><rect class="svg-node-authority" x="490" y="50" width="140" height="55" rx="10" />
<text class="svg-title" x="560.0" y="83.5" text-anchor="middle">Catalog API</text></g>
  <g><rect class="svg-node" x="10" y="495" width="140" height="45" rx="10" />
<text class="svg-title" x="80.0" y="523.5" text-anchor="middle">Browser</text></g>
  <g><rect class="svg-node-core" x="170" y="495" width="140" height="45" rx="10" />
<text class="svg-title" x="240.0" y="523.5" text-anchor="middle">UI host</text></g>
  <g><rect class="svg-node-authority" x="490" y="495" width="140" height="45" rx="10" />
<text class="svg-title" x="560.0" y="523.5" text-anchor="middle">Catalog API</text></g>
</svg>
</div>
