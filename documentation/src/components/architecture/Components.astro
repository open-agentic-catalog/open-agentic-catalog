---
import "../../styles/architecture.css";
import DiagramCard from "./DiagramCard.astro";
---
<div class="catalog-architecture" role="region" aria-labelledby="components-title" tabindex="0">
<svg class="architecture-svg" viewBox="0 0 640 450" role="img" aria-labelledby="components-title components-desc">
  <title id="components-title">Backend calls and source dependencies</title>
  <desc id="components-desc">API handlers call domain services. Domain services call their own ports, implemented by platform adapters. Platform code depends on those contracts. Runtime composition constructs and injects the implementations. SQL and remote systems stay at the edge of the same Go application.</desc>
  <defs><marker id="components-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10z" /></marker></defs>
  <path class="svg-connector" d="M200 58 H230" marker-end="url(#components-arrow)" />
  <path class="svg-connector" d="M410 58 H440" marker-end="url(#components-arrow)" />
  <path class="svg-connector svg-connector-dependency" d="M500 95 V145 H320 V95" marker-end="url(#components-arrow)" />
  <text class="svg-small" x="338" y="134">Implements ports</text>
  <path class="svg-connector svg-connector-dependency" d="M110 210 V180 H280 V95" marker-end="url(#components-arrow)" />
  <text class="svg-small" x="25" y="166">Build / inject</text>
  <path class="svg-connector" d="M530 95 V210" marker-end="url(#components-arrow)" />
  <text class="svg-small" x="542" y="176">SQL</text>
  <path class="svg-connector" d="M620 58 H630 V393 H620" marker-end="url(#components-arrow)" />
  <text class="svg-small" x="548" y="340">HTTPS</text>
  <DiagramCard x={20} y={20} width={180} title="API handlers" lines={["Decode and route"]} />
  <DiagramCard x={230} y={20} width={180} title="Domain" tone="core" lines={["Rules and ports"]} />
  <DiagramCard x={440} y={20} width={180} title="Platform" lines={["SQL / HTTP adapters"]} />
  <DiagramCard x={20} y={210} width={180} title="Runtime" lines={["Construct and wire"]} />
  <DiagramCard x={440} y={210} width={180} title="PostgreSQL" tone="authority" lines={["Records and leases"]} />
  <DiagramCard x={440} y={355} width={180} title="Remote" tone="external" lines={["HTTPS endpoints"]} />
  <text class="svg-small" x="24" y="369">Solid: runtime calls</text>
  <text class="svg-small" x="24" y="397">Dotted: code dependencies / wiring</text>
</svg>
</div>
