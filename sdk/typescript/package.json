{
  "name": "@open-agentic-catalog/client",
  "version": "0.1.0",
  "description": "Explicit, bounded Open Agentic Catalog client",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Mihai Criveti",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.20.0 <25"
  },
  "packageManager": "npm@12.2.2",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "openapi-typescript-helpers": "0.1.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "@types/node": "22.20.5",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.72.1",
    "globals": "17.13.0",
    "yaml": "2.9.1",
    "prettier": "3.9.10"
  },
  "overrides": {
    "js-yaml": "4.3.2"
  }
}
