# syntax=docker/dockerfile:1.28.0@sha256:bb22d9815c728170f72750f4e5b0d672e06176142e1d602c7e66c050100b7e5b
# Test-only fixture, built with the repository root as context; never ship it as
# the Catalog image. Its package closure uses only the Go standard library.
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.27.3-alpine3.24@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS build

WORKDIR /src
ENV GOTOOLCHAIN=local
ARG TARGETOS
ARG TARGETARCH

COPY go.mod go.sum ./
COPY test/functional/fixture ./test/functional/fixture
COPY examples/webhookreceiver ./examples/webhookreceiver
COPY internal/jsondoc ./internal/jsondoc

# No dependency download is needed; keep compilation offline.
RUN --network=none \
    --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} \
    go build -mod=readonly -trimpath -buildvcs=false -tags=netgo,osusergo -ldflags="-s -w -buildid=" -o /federation-fixture ./test/functional/fixture

FROM scratch

COPY --from=build --chmod=0555 /federation-fixture /federation-fixture

USER 65532:65532
EXPOSE 53/udp 53/tcp 8081 8443
STOPSIGNAL SIGTERM
ENTRYPOINT ["/federation-fixture"]
CMD ["serve"]
